def cmd_setup(a) -> None:
    if not sys.stdin.isatty():
        die("setup is interactive; use 'llmt install KEY...' and 'llmt mcp config' in scripts")
    setup = load_setup()
    if SHARED:
        return setup_shared(setup)
    say(f"llm-translators {__version__} — setup ({ROOT})\n")
    show_macos_warnings()
    say("Available translators:")
    table()

    elsewhere = (probe(None, str(ROOT)) or {}).get("found", {})
    if elsewhere:
        say("\nAlready installed on this machine outside llm-translators (the earlier layout):")
        for k, paths in elsewhere.items():
            for p in paths:
                say(f"  {k}: {p}")
        say("  They keep working and stay untouched. Installing a translator here makes a separate copy in")
        say("  llm-translators' venv; in step 4 the Claude app can use either ([l]ocal or [e]xisting). After")
        say("  switching to llm-translators, the old venvs can be deleted.")

    say("\nStep 1/4 — Where does each translator run, seen from this machine?")
    say("  h = here: installed on this machine (its MCP server runs here)")
    say("  r = remote: installed on another machine (e.g. a Linux workstation with the solvers); the Claude")
    say("      app here reaches it over ssh. Nothing is installed here for it; step 4 asks for the host.")
    say("  n = not used from this machine")
    say("  On a workstation that only serves translators to other machines, answer h for what it runs.")
    has_app = has_claude_app()
    prev_mcp = setup.get("mcp", {})
    inst = set(installed_in_venv())
    place = {}
    for k in KEYS:
        t = REGISTRY[k]
        prev = setup.get("placement", {}).get(k)
        if prev:
            d = prev[0]
        elif k in inst or k in setup.get("installed", []):
            d = "h"
        elif prev_mcp.get(k, {}).get("where") in ("remote", "existing"):
            d = "r"
        elif not has_app:
            d = "h" if t.get("suggest") == "remote" else "n"
        else:
            d = t.get("suggest", "here")[0]
        say(f"\n  {k} ({t['repo']}): {t['cost']}")
        while True:
            a_ = ask(f"{k}: [h]ere, [r]emote, [n]ot used", d).lower()[:1]
            if a_ in ("h", "r", "n"):
                break
        place[k] = {"h": "here", "r": "remote", "n": "none"}[a_]
    keys = [k for k in KEYS if place[k] == "here"]
    keys = with_uses(keys, interactive=True, assume_yes=True)
    for k in keys:
        place[k] = "here"
    setup["placement"] = place
    save_setup(setup)
    here_ = [k for k in KEYS if place[k] == "here"]
    remote_ = [k for k in KEYS if place[k] == "remote"]
    say(f"\n  Install here: {', '.join(here_) or 'nothing'}." +
        (f"  Reached on another machine: {', '.join(remote_)} (step 4)." if remote_ else ""))

    if keys:
        say("\nStep 2/4 — Python environment")
        if VPY.exists():
            say(f"  venv: {VENV} (Python {venv_python_version()})")
            python = None
        else:
            default = default_python()
            arm_linux = sys.platform.startswith("linux") and platform.machine() in ("aarch64", "arm64")
            if arm_linux and any(b["key"] == "gmsh" for k in keys for b in REGISTRY[k]["backends"]):
                say("  Linux on ARM: Gmsh comes from apt (python3-gmsh), so the venv must use the system's Python.")
                default = "/usr/bin/python3"
            while True:
                python = ask("Python for the venv (3.10+)", default)
                v = python_version(python)
                if v and v >= (3, 10):
                    break
                warn(f"{python}: not a Python 3.10+ interpreter")
        setup["test"] = yes("Install the test tools (pytest)?", setup.get("test", True))
        for k in keys:
            for e, what in REGISTRY[k]["optional_extras"].items():
                have = e in setup.get("extras", {}).get(k, [])
                if yes(f"{k}: {what}?", have):
                    setup.setdefault("extras", {}).setdefault(k, [])
                    if e not in setup["extras"][k]:
                        setup["extras"][k].append(e)
                elif have:
                    setup["extras"][k].remove(e)
        do_install(keys, setup, python, interactive=True, link_gmsh=None)
        dropped = [k for k in setup.get("installed", []) if k not in keys]
        if dropped:
            say(f"  Still installed from before: {', '.join(dropped)} (llmt remove {' '.join(dropped)} to uninstall)")

        say(f"\nStep 3/4 — Backends (installed separately: {BACKENDS_MD})")
        missing_any = False
        for k in keys:
            if not REGISTRY[k]["backends"]:
                say(f"  {k}: no backend needed")
                continue
            for name, ok, what, b in backend_report(k, tool_status(k)):
                say(f"  {k}: {name}: " + (f"ok ({what})" if ok else f"MISSING — {what}"))
                if not ok:
                    missing_any = True
                    say(f"  {'':{len(k)}}  without it: {b['without']}. See {BACKENDS_MD}#{b['doc']}")
        q = ("Set backend paths in config/env now (if a backend is installed somewhere unusual)?" if missing_any
             else "Review the backend paths in config/env?")
        if any(REGISTRY[k]["backends"] for k in keys) and yes(q, missing_any):
            cur_env = env_read()
            for k in keys:
                for var, what in REGISTRY[k]["env"].items():
                    if var.endswith(("_OUT", "_WORKERS", "_TIMEOUT", "_SOLVER", "_PROCS", "_MPIRUN")) and var not in cur_env:
                        continue
                    val = ask(f"{var} ({what}; '-' clears)", cur_env.get(var, ""))
                    if val != cur_env.get(var, ""):
                        env_set({var: "" if val == "-" else val})
            say(f"  {ENV_FILE} updated (other settings: llmt env --edit)")
            for k in keys:
                if REGISTRY[k]["backends"]:
                    for name, ok, what, _ in backend_report(k, tool_status(k)):
                        say(f"  {k}: {name}: " + ("ok" if ok else "still missing") + f" ({what})")
        tune_interactive(keys)
        alias_interactive(setup)
    else:
        say("\n  Nothing to install here (steps 2 and 3 skipped).")
        save_setup(setup)

    say("\nStep 4/4 — MCP servers")
    if remote_ or yes("Will a Claude app on this machine use the translators?", has_app):
        mcp_setup_interactive(setup, hint=place)
    else:
        say(f"  On the machine with the Claude app, run 'llmt mcp setup' and choose 'remote' with this host and {ROOT}.")
    say("\nDone. Check any time with: llmt status")


