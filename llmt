                                 [k for k, s in mcp.items() if s.get("where") == "none"])
            say("  Then: llmt mcp test, and restart the Claude app.")
    elif a.router_cmd == "status":
        import importlib.util as _u
        from importlib.machinery import SourceFileLoader
        loader = SourceFileLoader("llmt_router", str(ROOT / "llmt_router.py"))
        mod = _u.module_from_spec(_u.spec_from_loader("llmt_router", loader))
        loader.exec_module(mod)
        keys = parse_keys(a.keys) if a.keys else [k for k, s in setup.get("mcp", {}).items() if s.get("where") == "router"]
        if not (setup.get("router") or {}).get("hosts"):
            die("no router machines yet: llmt router setup")
        for k in keys or KEYS:
            data = mod.Router(k).machines()
            say(f"\n{k}")
            for m in data["machines"]:
                if not m.get("reachable"):
                    say(f"  {m['machine']:10} unreachable: {str(m.get('error', ''))[:120]}")
                    continue
                if not m.get("version"):
                    say(f"  {m['machine']:10} {k} not installed")
                    continue
                ex = m.get("executor") or {}
                sl = m.get("slurm") or {}
                q = m.get("queue") or {}
                use = (f"{sl.get('cpus_allocated')}/{sl.get('cpus')} CPUs in use, {q.get('running', 0)} running, "
                       f"{q.get('waiting', 0)} waiting" if sl else f"load {m.get('load')} on {m.get('cores')} cores")
                miss = m.get("backends_missing") or []
                say(f"  {m['machine']:10} {m['version']:14} {ex.get('kind', 'local'):6} {use}; "
                    f"typical job starts in {m.get('typical_job_start_min')} min"
                    + (f"; MISSING {', '.join(miss)}" if miss else "")
                    + ("  [preferred]" if m.get("preferred") else "") + ("  [excluded]" if m.get("excluded") else ""))


