def cmd_mcp(a) -> None:
    setup = load_setup()
    if a.mcp_cmd == "setup":
        if not sys.stdin.isatty():
            die("mcp setup is interactive")
        mcp_setup_interactive(setup)
    elif a.mcp_cmd == "config":
        entries = mcp_entries(setup)
        if not entries:
            die("no MCP servers chosen yet: llmt mcp setup")
        if a.print:
            print(json.dumps({"mcpServers": entries}, indent=1))
        elif a.claude_code:
            for k, e in entries.items():
                print(f"claude mcp add-json --scope user {k} {shlex.quote(json.dumps({'type': 'stdio', **e}))}")
        else:
            path = Path(a.file).expanduser() if a.file else claude_desktop_config()
            write_desktop_config(entries, path, [k for k, s in setup.get("mcp", {}).items() if s.get("where") == "none"])
    elif a.mcp_cmd == "test":
        sys.exit(0 if mcp_test(parse_keys(a.keys) if a.keys else None, setup, a.timeout) else 1)
    elif a.mcp_cmd == "serve":
        keys = parse_keys(a.keys) if a.keys else [k for k in setup.get("installed", []) if k in installed_in_venv()]
        if not keys:
            die("nothing installed here to serve")
        mcp_serve(keys, a.host)


def main(argv: list[str] | None = None) -> None:
    ap = argparse.ArgumentParser(prog="llmt", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--version", action="version", version=f"llm-translators {__version__}")
    sub = ap.add_subparsers(dest="cmd")
    sub.add_parser("setup", help="guided setup")
    sub.add_parser("list", help="the translators")
    p = sub.add_parser("install", help="install translators into the shared venv")
    p.add_argument("keys", nargs="*", help=f"{' | '.join(KEYS)} | all (default: those installed before)")
    p.add_argument("--python", help="interpreter for a new venv (default: the one running llmt)")
