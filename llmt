def submodule_url(path: str) -> str:
    """The submodule's URL, resolved against the umbrella's origin (relative URLs in .gitmodules)."""
    r = git("config", "--get", f"submodule.{path}.url", check=False)
    if not r.stdout.strip():
        git("submodule", "init", "--", path)
        r = git("config", "--get", f"submodule.{path}.url", check=False)
    return r.stdout.strip()


def submodule_branch(path: str) -> str:
    r = git("config", "-f", ".gitmodules", "--get", f"submodule.{path}.branch", check=False)
    return r.stdout.strip() or "main"


def cmd_pin(a) -> None:
    """Moves the umbrella's pins to each translator's latest pushed commit (or --to COMMIT)."""
    refuse_in_release("pinning")
    keys = parse_keys(a.keys) if a.keys else KEYS
    if a.to and len(keys) != 1:
        die("--to needs exactly one translator")
    staged_before = set(git("diff", "--cached", "--name-only").stdout.split())
    subs = submodule_states()
    changed = []
    for k in keys:
        path = REGISTRY[k]["repo"]
        pinned = git("ls-files", "-s", "--", path).stdout.split()[1]   # the index: includes pins not yet committed
        branch = submodule_branch(path)
        url = submodule_url(path)
        if a.to:
            target = a.to
        else:
            r = run(["git", "ls-remote", url, f"refs/heads/{branch}"], capture=True, check=False, timeout=60)
            if r.returncode != 0 or not r.stdout.strip():
                warn(f"{k}: cannot read {branch} of {url}: {(r.stderr or '').strip()[-200:]}")
                continue
            target = r.stdout.split()[0]
        state = subs.get(path, ("absent", ""))[0]
        checked_out = state != "absent" and (ROOT / path / ".git").exists()
        if checked_out:
            if git("-C", path, "status", "--porcelain", check=False).stdout.strip():
                warn(f"{k}: {path} has uncommitted changes: not moved")
                continue
            git("-C", path, "fetch", "--quiet", "origin", branch if not a.to else a.to, check=False)
            r = git("-C", path, "rev-parse", "--verify", f"{target}^{{commit}}", check=False)
            if r.returncode != 0:
                warn(f"{k}: commit {target} not found in {url}")
                continue
            target = r.stdout.strip()
        elif len(target) != 40:
            die(f"--to: give the full 40-character commit for {k} (it is not checked out here)")
        if target == pinned:
            say(f"  {k}: up to date ({pinned[:7]})")
            continue
        log = ""
        if checked_out:
            git("-C", path, "checkout", "--quiet", "--detach", target)
            log = git("-C", path, "log", "--oneline", "--no-decorate", f"{pinned}..{target}", check=False).stdout.strip()
            git("add", "--", path)
        else:
            git("update-index", "--cacheinfo", f"160000,{target},{path}")
        say(f"  {k}: {pinned[:7]} -> {target[:7]}" + ("" if checked_out else "  (not checked out here)"))
        for line in log.splitlines()[:15]:
            say(f"        {line}")
        changed.append((k, path, pinned, target))
    if not changed:
        say("  Nothing to pin.")
        return
    paths = [p for _, p, _, _ in changed]
    msg = "Pin " + ", ".join(f"{k} {t[:7]}" for k, _, _, t in changed)
    if a.commit:
        others = staged_before - set(paths)
        if others:
            warn(f"other changes are staged ({', '.join(sorted(others))}): not committing; commit by hand")
            return
        git("commit", "--quiet", "-m", msg, capture=False)
        say(f"  committed: {msg}")
        if a.push:
            git("push", capture=False)
    else:
        say(f"\n  Staged. Record them with: git commit -m '{msg}'   (or rerun with --commit [--push])")
    say("  Then on each machine: llmt update   (pulls, checks out the new pins, reinstalls)")


def cmd_test(a) -> None:
    setup = load_setup()
    keys = parse_keys(a.keys) if a.keys else setup.get("installed", [])
    results = {}
    for k in keys:
        say(f"\n=== {k}: pytest")
        extra = ["-p", "no:cacheprovider"] if SHARED else []
        env = {**os.environ, "PYTHONDONTWRITEBYTECODE": "1"} if SHARED else None
        # pytest writes a JUnit report at the very end: a run that ends without it (a test that killed the process,
        # e.g. with os._exit(0)) is a failure even with exit code 0 (omct 2026.10.23.3 under deploy --test)
        fd, junit = tempfile.mkstemp(prefix=f"llmt-{k}-", suffix=".xml")
        os.close(fd)
        os.unlink(junit)
        try:
            r = subprocess.run([str(ROOT / "bin" / "run"), "python", "-m", "pytest", "-q", *extra,
                                f"--junit-xml={junit}", *a.pytest_args], cwd=ROOT / REGISTRY[k]["repo"], env=env)
            rc = r.returncode
            if rc == 0 and not os.path.exists(junit):
                warn(f"{k}: pytest exited with 0 but did not finish (no report): counted as a failure")
                rc = 1
        finally:
            if os.path.exists(junit):
                os.unlink(junit)
        results[k] = rc
    say("\n" + "  ".join(f"{k}: {'pass' if rc == 0 else 'FAIL'}" for k, rc in results.items()))
    sys.exit(0 if all(rc == 0 for rc in results.values()) else 1)


