__version__ = "2026.10.25.1"

ROOT = Path(__file__).resolve().parent
VENV = ROOT / ".venv"
VPY = VENV / "bin" / "python"
# A shared release (docs/SHARED.md) has RELEASE.json next to llmt: <prefix>/releases/<name>/. Anything else is a
# personal checkout, with its state in config/ inside it.
RELEASE_FILE = ROOT / "RELEASE.json"
SHARED = RELEASE_FILE.exists()
PREFIX = ROOT.parent.parent if SHARED else None
DEFAULT_PREFIX = Path(os.environ.get("LLMT_PREFIX", "/opt/llm-translators"))
SYSTEM_ENV = Path(os.environ.get("LLMT_SYSTEM_ENV", "/etc/llm-translators/env"))
USER_DIR = Path(os.environ.get("XDG_CONFIG_HOME") or (Path.home() / ".config")) / "llm-translators"
CONFIG_DIR = USER_DIR if SHARED else ROOT / "config"
SETUP_FILE = CONFIG_DIR / "setup.json"
ENV_FILE = CONFIG_DIR / "env"


def _entry_root() -> Path:
    """The folder MCP entries and the alias point to: <prefix>/current when it is this release (so they follow
    the admin's updates), else this folder."""
    if SHARED:
        cur = PREFIX / "current"
        try:
            if cur.resolve() == ROOT:
                return cur
        except OSError:
            pass
    return ROOT


ENTRY_ROOT = _entry_root()


def release_info(path: Path | None = None) -> dict:
    try:
        return json.loads(((path or ROOT) / "RELEASE.json").read_text())
    except (OSError, json.JSONDecodeError):
        return {}
REGISTRY = json.loads((ROOT / "translators.json").read_text())["translators"]
KEYS = list(REGISTRY)
BACKENDS_MD = "BACKENDS.md"


# ---------------------------------------------------------------- small helpers

def say(msg: str = "") -> None:
    print(msg, flush=True)


def warn(msg: str) -> None:
    print(f"  ! {msg}", file=sys.stderr, flush=True)


def die(msg: str, code: int = 1) -> None:
    print(f"llmt: {msg}", file=sys.stderr)
    sys.exit(code)


def run(cmd: list[str], check: bool = True, capture: bool = False, cwd: Path | None = None,
        timeout: float | None = None) -> subprocess.CompletedProcess:
    if not capture:
        say("  $ " + " ".join(shlex.quote(str(c)) for c in cmd))
    r = subprocess.run([str(c) for c in cmd], cwd=cwd, text=True, timeout=timeout,
                       capture_output=capture)
    if check and r.returncode != 0:
        err = (r.stderr or "").strip() if capture else ""
        die(f"command failed ({r.returncode}): {' '.join(map(str, cmd))}" + (f"\n{err}" if err else ""))
    return r


def git(*args: str, capture: bool = True, check: bool = True) -> subprocess.CompletedProcess:
    return run(["git", "-C", ROOT, *args], capture=capture, check=check)


def ask(prompt: str, default: str = "") -> str:
    d = f" [{default}]" if default else ""
    try:
        a = input(f"  {prompt}{d}: ").strip()
    except EOFError:
        a = ""
    return a or default


def yes(prompt: str, default: bool = True) -> bool:
    d = "Y/n" if default else "y/N"
    while True:
        try:
            a = input(f"  {prompt} [{d}]: ").strip().lower()
        except EOFError:
            a = ""
        if not a:
            return default
        if a in ("y", "yes"):
            return True
        if a in ("n", "no"):
            return False


def load_setup() -> dict:
    s = {"installed": [], "extras": {}, "test": True, "mcp": {}}
    if SETUP_FILE.exists():
        try:
            s = json.loads(SETUP_FILE.read_text())
        except json.JSONDecodeError:
            warn(f"{SETUP_FILE} is not valid JSON: starting from defaults")
    if SHARED:  # what is installed is the release's business
        s["installed"] = [k for k in KEYS if k in release_info().get("keys", [])]
    return s


def save_setup(s: dict) -> None:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    s["llmt"] = __version__
    s["updated"] = _dt.datetime.now().isoformat(timespec="seconds")
    SETUP_FILE.write_text(json.dumps(s, indent=1) + "\n")


def parse_keys(text: str | list[str]) -> list[str]:
    """'1 2 cfdt' or ['b3dt', 'feat'] -> keys in registry order; 'all' for every one."""
    items = text.replace(",", " ").split() if isinstance(text, str) else list(text)
    out = set()
    for it in items:
        if it == "all":
            out.update(KEYS)
        elif it.isdigit() and 1 <= int(it) <= len(KEYS):
            out.add(KEYS[int(it) - 1])
        elif it in REGISTRY:
            out.add(it)
        else:
            by_repo = [k for k, t in REGISTRY.items() if t["repo"] == it]
            if not by_repo:
                die(f"unknown translator '{it}' (known: {', '.join(KEYS)})")
            out.update(by_repo)
    return [k for k in KEYS if k in out]


def venv_python_version() -> str | None:
    if not VPY.exists():
        return None
    r = run([VPY, "-c", "import sys; print('%d.%d.%d' % sys.version_info[:3])"], capture=True, check=False)
    return r.stdout.strip() or None


def python_version(py: str) -> tuple[int, ...] | None:
    try:
        r = subprocess.run([py, "-c", "import sys; print(*sys.version_info[:3])"], capture_output=True, text=True, timeout=30)
        return tuple(int(x) for x in r.stdout.split()) if r.returncode == 0 else None
    except (OSError, subprocess.TimeoutExpired):
        return None


def default_python() -> str:
    """The interpreter running llmt if it is 3.10+, else the newest python3.1x found (macOS's
    /usr/bin/python3 is 3.9)."""
    if sys.version_info >= (3, 10):
        return sys.executable
    for minor in range(20, 9, -1):
        p = shutil.which(f"python3.{minor}")
        if p:
            return p
    for p in ("/opt/homebrew/bin/python3", "/usr/local/bin/python3"):
        v = python_version(p) if os.path.exists(p) else None
        if v and v >= (3, 10):
            return p
    return sys.executable


def installed_in_venv() -> dict[str, str]:
    """key -> version for the translators importable from the venv."""
    if not VPY.exists():
        return {}
    code = ("import importlib, json\nout = {}\n"
            f"for k, p in {json.dumps({k: t['package'] for k, t in REGISTRY.items()})}.items():\n"
            "    try:\n        m = importlib.import_module(p); out[k] = getattr(m, '__version__', '?')\n"
            "    except Exception:\n        pass\nprint(json.dumps(out))")
    r = run([VPY, "-c", code], capture=True, check=False)
    try:
        return json.loads(r.stdout)
    except json.JSONDecodeError:
        return {}


_GIT_WARNED = False


def git_trouble(stderr: str, fatal: bool = False) -> None:
    """Says why git failed in this checkout, once (e.g. 'dubious ownership' when the checkout belongs to
    another user, such as root after 'sudo git clone')."""
    global _GIT_WARNED
    msg = (stderr or "git failed").strip().splitlines()
    text = msg[0] if msg else "git failed"
    if "dubious ownership" in (stderr or ""):
        owner = ""
        try:
            import pwd
            owner = pwd.getpwuid(ROOT.stat().st_uid).pw_name
        except (ImportError, KeyError, OSError):
            pass
        text = (f"git refuses this checkout: it belongs to {owner or 'another user'}, not to you. Run llmt as "
                f"{owner or 'its owner'} (e.g. sudo ./llmt ...), or trust it: git config --global --add "
                f"safe.directory {ROOT}")
    if fatal:
        die(text)
    if not _GIT_WARNED:
        warn(text)
        _GIT_WARNED = True


def submodule_states() -> dict[str, tuple[str, str]]:
    """repo path -> (state, commit); state: pinned | moved | absent | conflict (a release: release | absent)."""
    if SHARED:
        info = release_info()
        return {t["repo"]: (("release", info.get("commits", {}).get(t["repo"], "")[:7]) if k in info.get("keys", [])
                            else ("absent", "")) for k, t in REGISTRY.items()}
    r = git("submodule", "status", check=False)
    if r.returncode != 0:
        git_trouble(r.stderr)
    out = {}
    for line in r.stdout.splitlines():
        if not line.strip():
            continue
        flag, rest = line[0], line[1:].split()
        state = {" ": "pinned", "+": "moved", "-": "absent", "U": "conflict"}.get(flag, "?")
        out[rest[1]] = (state, rest[0][:7])
    return out


def with_uses(keys: list[str], interactive: bool, assume_yes: bool) -> list[str]:
    """Adds the translators the chosen ones use (b3dt for feat, ...), asking when interactive."""
    chosen, declined = set(keys), set()
    changed = True
    while changed:
        changed = False
        for k in [k for k in KEYS if k in chosen]:
            for u, why in REGISTRY[k]["uses"].items():
                if u in chosen or u in declined:
                    continue
                if interactive:
                    add = yes(f"{k} uses {u} ({why}). Install {u} too?", True)
                else:
                    add = assume_yes
                    if not add:
                        say(f"  note: {k} can use {u} ({why}); add it with: llmt install {u}")
                if add:
                    chosen.add(u)
                    changed = True
                else:
                    declined.add(u)
    return [k for k in KEYS if k in chosen]


# ---------------------------------------------------------------- the env file

def env_read(path: Path | None = None) -> dict[str, str]:
    path = path or ENV_FILE
    vals = {}
    try:
        text = path.read_text() if path.exists() else ""
    except OSError:
        text = ""
    if text:
        for line in text.splitlines():
            m = re.match(r"\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)=(.*)$", line)
            if m:
                v = m.group(2).strip()
                try:
                    v = " ".join(shlex.split(v)) if v else ""
                except ValueError:
                    pass
                vals[m.group(1)] = v
    return vals


def env_effective() -> dict[str, str]:
    """The settings as bin/run loads them: the machine's file, then the user's, then (a release) the machine's caps."""
    sysv = env_read(SYSTEM_ENV) if SYSTEM_ENV != ENV_FILE else {}
    v = {**sysv, **env_read(ENV_FILE)}
    if SHARED:
        v.update({k: x for k, x in sysv.items() if "_MAX_" in k})
    return v


def env_template() -> str:
    if ENV_FILE == SYSTEM_ENV:
        head = ["# llm-translators: settings for this machine, for every user and every install on it (docs/SHARED.md).",
                "# Sourced first by bin/run, bin/mcp and bin/activate; a user's own file comes after it, but the",
                "# caps (*_MAX_*) here always win for a shared release. Only the admin may write this file."]
    elif SHARED:
        head = ["# llm-translators: your own settings, sourced after the machine's " + str(SYSTEM_ENV) + ".",
                "# Shell syntax, KEY=value. The machine's caps (*_MAX_*) always win (docs/SHARED.md)."]
    else:
        head = ["# llm-translators: settings for this machine (sourced by bin/run, bin/mcp and bin/activate).",
                "# Shell syntax, KEY=value. Not tracked by git. The MCP servers do not read ~/.bashrc",
                "# (ssh runs them in a non-interactive shell), so put backend paths here.",
                f"# A machine-wide {SYSTEM_ENV}, if there is one, is loaded before this file."]
    lines = head + [
        "",
        "# Extra folders for executables, e.g. Homebrew on macOS:",
        "# PATH=/opt/homebrew/bin:$PATH",
        "",
    ]
    for k, t in REGISTRY.items():
        if not t["env"]:
            continue
        lines.append(f"# --- {k} ({t['repo']})")
        for var, what in t["env"].items():
            lines.append(f"# {var + '=':17} # {what}")
        lines.append("")
    return "\n".join(lines)


def env_set(updates: dict[str, str]) -> None:
    """Sets (or comments out, for '') variables in config/env, keeping the rest of the file."""
    ENV_FILE.parent.mkdir(parents=True, exist_ok=True)
    text = ENV_FILE.read_text() if ENV_FILE.exists() else env_template()
    lines = text.splitlines()
    for var, val in updates.items():
        new = f"{var}={shlex.quote(val)}" if val else None
        hit = None
        for i, line in enumerate(lines):
            if re.match(rf"\s*(?:export\s+)?{var}=", line):
                hit = i
                break
        if hit is None:
            for i, line in enumerate(lines):
                if re.match(rf"\s*#\s*{var}=", line):
                    hit = i
                    break
        if new is None:
            if hit is not None and not lines[hit].lstrip().startswith("#"):
                lines[hit] = "# " + lines[hit]
        elif hit is not None:
            lines[hit] = new
        else:
            lines.append(new)
    ENV_FILE.write_text("\n".join(lines) + "\n")


def ensure_env_file() -> None:
    if not ENV_FILE.exists():
        ENV_FILE.parent.mkdir(parents=True, exist_ok=True)
        ENV_FILE.write_text(env_template() + "\n")


# ---------------------------------------------------------------- install

def make_venv(python: str | None) -> None:
    if VPY.exists():
        say(f"  venv: {VENV} (Python {venv_python_version()})")
        return
    py = python or default_python()
    v = python_version(py)
    if v is None:
        die(f"cannot run {py}")
    if v < (3, 10):
        die(f"{py} is Python {'.'.join(map(str, v))}: 3.10 or later is needed (llmt install --python PATH)")
    say(f"  creating the venv with {py} (Python {'.'.join(map(str, v))})")
    run([py, "-m", "venv", "--prompt", "llm-translators", VENV])
    run([VPY, "-m", "pip", "install", "--quiet", "--upgrade", "pip"])


def checkout(keys: list[str]) -> None:
    paths = [REGISTRY[k]["repo"] for k in keys]
    states = submodule_states()
    todo = [p for p in paths if states.get(p, ("absent",))[0] == "absent"]
    if todo:
        git("submodule", "update", "--init", "--", *todo, capture=False)
    for p in paths:
        if not (ROOT / p / "pyproject.toml").exists():
            die(f"{p} is not checked out (git submodule update --init {p})")


def pip_install(keys: list[str], setup: dict, upgrade: bool = False) -> None:
    specs = []
    for k in keys:
        t = REGISTRY[k]
        extras = list(t["extras"]) + ([t["test_extra"]] if setup.get("test", True) and t.get("test_extra") else [])
        extras += [e for e in setup.get("extras", {}).get(k, []) if e in t["optional_extras"]]
        specs += ["-e", f"{ROOT / t['repo']}[{','.join(extras)}]"]
    cmd = [VPY, "-m", "pip", "install"] + (["--upgrade"] if upgrade else []) + specs
    run(cmd)


def gmsh_fixup(keys: list[str], interactive: bool, link: bool | None) -> None:
    """Linux on ARM: PyPI has no Gmsh wheels; the system's python3-gmsh can be linked into the venv."""
    needs = [k for k in keys if any(b["key"] == "gmsh" for b in REGISTRY[k]["backends"])]
    if not needs:
        return
    r = run([VPY, "-c", "import gmsh"], capture=True, check=False)
    if r.returncode == 0:
        return
    sysmod = Path("/usr/lib/python3/dist-packages/gmsh.py")
    vv = venv_python_version() or ""
    site = VENV / "lib" / f"python{'.'.join(vv.split('.')[:2])}" / "site-packages"
    sys_py = python_version("/usr/bin/python3") if Path("/usr/bin/python3").exists() else None
    same = sys_py is not None and ".".join(map(str, sys_py[:2])) == ".".join(vv.split(".")[:2])
    if sysmod.exists() and same and site.is_dir():
        do = link if link is not None else (yes(f"Gmsh is not in the venv; link the system's {sysmod} into it?", True)
                                            if interactive else False)
        if do:
            dst = site / "gmsh.py"
            if dst.exists() or dst.is_symlink():
                dst.unlink()
            dst.symlink_to(sysmod)
            ok = run([VPY, "-c", "import gmsh; print(gmsh.__version__)"], capture=True, check=False)
            say(f"  linked {dst} -> {sysmod}: " + (f"Gmsh {ok.stdout.strip()}" if ok.returncode == 0 else "import still fails"))
            return
        say(f"  Gmsh: link it with: llmt install --link-system-gmsh {' '.join(keys)}")
        return
    why = ("the venv's Python differs from the system's" if sysmod.exists() and not same
           else "no Gmsh wheel for this platform and no system python3-gmsh")
    warn(f"Gmsh is not importable in the venv ({why}): see {BACKENDS_MD}#gmsh")


def do_install(keys: list[str], setup: dict, python: str | None, interactive: bool, link_gmsh: bool | None,
               upgrade: bool = False) -> None:
    say(f"\nInstalling {', '.join(keys)} into {VENV}")
    make_venv(python)
    checkout(keys)
    pip_install(keys, setup, upgrade)
    gmsh_fixup(keys, interactive, link_gmsh)
    setup["installed"] = [k for k in KEYS if k in set(setup.get("installed", [])) | set(keys)]
    save_setup(setup)
    ensure_env_file()
    say("  done.")


# ---------------------------------------------------------------- run limits (MPI ranks, timeouts)

def _sysctl(name: str) -> int | None:
    try:
        r = subprocess.run(["sysctl", "-n", name], capture_output=True, text=True, timeout=10)
        return int(r.stdout.strip()) if r.returncode == 0 and r.stdout.strip() else None
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return None


def cpu_info() -> dict:
    """Physical cores usable here (hyperthreads do not help MPI solvers), logical CPUs, and core kinds
    when they differ (Apple P/E cores, ARM big.LITTLE)."""
    logical = os.cpu_count() or 1
    if hasattr(os, "sched_getaffinity"):
        try:
            logical = len(os.sched_getaffinity(0))   # what this process may use (containers, taskset)
        except OSError:
            pass
    physical, kinds = None, []
    if sys.platform == "darwin":
        physical = _sysctl("hw.physicalcpu")
        for lvl, name in ((0, "performance"), (1, "efficiency")):
            n = _sysctl(f"hw.perflevel{lvl}.physicalcpu")
            if n:
                kinds.append((n, name))
    elif sys.platform.startswith("linux"):
        try:
            r = subprocess.run(["lscpu", "-p=CPU,CORE,SOCKET"], capture_output=True, text=True, timeout=10)
            allowed = os.sched_getaffinity(0) if hasattr(os, "sched_getaffinity") else None
            cores = set()
            for line in r.stdout.splitlines():
                if line.startswith("#") or not line.strip():
                    continue
                cpu, core, sock = (line.split(",") + ["", "", ""])[:3]
                if allowed is None or (cpu.isdigit() and int(cpu) in allowed):
                    cores.add((sock, core))
            physical = len(cores) or None
        except (OSError, subprocess.TimeoutExpired):
            pass
        caps: dict[int, int] = {}
        for f in Path("/sys/devices/system/cpu").glob("cpu[0-9]*/cpu_capacity"):
            try:
                c = int(f.read_text().strip())
                caps[c] = caps.get(c, 0) + 1
            except (OSError, ValueError):
                pass
        if len(caps) > 1:
            top = max(caps)
            kinds = [(caps[top], "performance"), (sum(n for c, n in caps.items() if c != top), "efficiency")]
    physical = min(physical or logical, logical)
    return {"physical": physical, "logical": logical, "kinds": kinds}


def slurm_info() -> dict | None:
    """SLURM on this machine (single node expected): None without sbatch, else what sinfo/scontrol say."""
    sb = shutil.which("sbatch")
    if not sb:
        return None
    info = {"sbatch": sb}
    nodes = slurm_nodes()
    if nodes:                       # per node (scontrol): robust to several partitions or node groups in sinfo
        ok = [n for n in nodes if n["usable"]]
        use = ok or nodes
        me = local_node(nodes)
        info.update(cluster_nodes=len(nodes), node=me,
                    cluster_cpus=sum(n["cpus"] for n in use), cluster_cpus_allocated=sum(n["alloc"] for n in use))
        if len(nodes) > 1 and me:   # a cluster: this machine's jobs run on its own node (docs/EXECUTION.md)
            n = next(x for x in nodes if x["name"] == me)
            info.update(cpus=n["cpus"], cpus_allocated=n["alloc"], nodes=",".join(x["name"] for x in nodes),
                        state=n["state"], nodes_usable=1 if n["usable"] else 0, mem_mb=str(n["mem"]),
                        shared_home=shared_home())
        else:
            info.update(cpus=sum(n["cpus"] for n in use), cpus_allocated=sum(n["alloc"] for n in use),
                        nodes=",".join(n["name"] for n in nodes), state=use[0]["state"],
                        nodes_usable=len(ok), mem_mb=str(sum(n["mem"] for n in use)))
            if len(nodes) > 1:
                info["shared_home"] = shared_home()
    try:
        r = subprocess.run(["sinfo", "-h", "-o", "%C|%m|%l|%N|%t"], capture_output=True, text=True, timeout=20)
        line = r.stdout.strip().splitlines()[0] if r.returncode == 0 and r.stdout.strip() else ""
        if line:
            c, mem, lim, nodes_, st = (line.split("|") + [""] * 5)[:5]
            a, i, o, t = (c.split("/") + ["0"] * 4)[:4]
            info["time_limit"] = lim
            if not nodes:
                info.update(cpus=int(t), cpus_allocated=int(a), mem_mb=mem, nodes=nodes_, state=st)
        else:
            info["error"] = (r.stderr or "sinfo printed nothing").strip()[-200:]
    except (OSError, ValueError, subprocess.TimeoutExpired) as exc:
        info["error"] = str(exc)
    try:
        r = subprocess.run(["scontrol", "show", "config"], capture_output=True, text=True, timeout=20)
        for line in r.stdout.splitlines():
            k, _, v = line.partition("=")
            if k.strip() in ("SelectType", "SelectTypeParameters", "AccountingStorageType"):
                info[k.strip()] = v.strip()
    except (OSError, subprocess.TimeoutExpired):
        pass
    return info


def slurm_nodes() -> list[dict]:
    """Each SLURM node (scontrol -o show node): name, state, usable, CPUs, allocated CPUs, memory (MB)."""
    try:
        r = subprocess.run(["scontrol", "-o", "show", "node"], capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.TimeoutExpired):
        return []
    out = []
    for line in r.stdout.splitlines():
        f = dict(kv.split("=", 1) for kv in line.split() if "=" in kv)
        if "NodeName" not in f:
            continue
        flags = f.get("State", "").upper().split("+")
        st = flags[0].lower() if flags and flags[0] else "?"
        bad = st.rstrip("*") in ("down", "drain", "fail", "future", "inval", "unknown") or \
            any(x in ("DRAIN", "DRAINED", "DRAINING", "NOT_RESPONDING", "FAIL") for x in flags[1:])
        try:
            out.append({"name": f["NodeName"], "state": st + ("+" + "+".join(flags[1:]).lower() if len(flags) > 1 else ""),
                        "usable": not bad, "cpus": int(f.get("CPUTot", 0) or 0), "alloc": int(f.get("CPUAlloc", 0) or 0),
                        "mem": int(f.get("RealMemory", 0) or 0), "host": f.get("NodeHostName", ""),
                        "addr": f.get("NodeAddr", "")})
        except ValueError:
            continue
    return out


def local_node(nodes: list) -> str | None:
    """The SLURM node that is this machine: by host name (NodeName, NodeHostName), else by address (NodeAddr)."""
    import socket
    names = {socket.gethostname(), socket.gethostname().split(".")[0]}
    for n in nodes:
        if n["name"] in names or n.get("host") in names or (n.get("host") or "").split(".")[0] in names:
            return n["name"]
    addrs = set()
    try:
        r = subprocess.run(["hostname", "-I"], capture_output=True, text=True, timeout=5)
        addrs.update(r.stdout.split())
    except (OSError, subprocess.TimeoutExpired):
        pass
    try:
        addrs.update(a[4][0] for a in socket.getaddrinfo(socket.gethostname(), None))
    except OSError:
        pass
    for n in nodes:
        if n.get("addr") in addrs:
            return n["name"]
    return None


SHARED_FS = ("nfs", "nfs4", "cifs", "smb", "smb2", "smbfs", "lustre", "gpfs", "beegfs", "ceph", "cephfs", "glusterfs",
             "fuse.sshfs", "fuse.glusterfs", "fuse.cephfs", "panfs", "wekafs", "afs")


def shared_home() -> bool:
    """The home folder is on a network filesystem (a job on another node would see the same run folders)."""
    try:
        r = subprocess.run(["stat", "-f", "-c", "%T", str(Path.home())], capture_output=True, text=True, timeout=5)
        t = r.stdout.strip().lower()
    except (OSError, subprocess.TimeoutExpired):
        return False
    return t in SHARED_FS or t.startswith(("nfs", "fuse.s", "ceph", "lustre", "gpfs"))


def slurm_jobs() -> list[dict]:
    """The user's queued and running translator jobs (job names '<cli>:<request>:<study>', docs/EXECUTION.md)."""
    clis = {t["cli"]: k for k, t in REGISTRY.items()}
    try:
        r = subprocess.run(["squeue", "-h", "-u", os.environ.get("USER", ""), "-o", "%i|%j|%T|%M|%l|%C|%R|%S"],
                           capture_output=True, text=True, timeout=20)
    except (OSError, subprocess.TimeoutExpired):
        return []
    out = []
    for line in r.stdout.splitlines():
        f = (line.split("|") + [""] * 8)[:8]
        cli, _, rest = f[1].partition(":")
        if cli not in clis:
            continue
        req, _, study = rest.partition(":")
        out.append({"id": f[0], "key": clis[cli], "request": req, "study": study, "state": f[2], "elapsed": f[3],
                    "limit": f[4], "cpus": f[5], "reason": f[6], "start": f[7]})
    return out


def slurm_notes(info: dict) -> list[str]:
    out = []
    if info.get("error"):
        out.append(f"sbatch is here but sinfo failed ({info['error']}): is slurmctld running?")
    if info.get("nodes_usable") == 0 or (info.get("nodes_usable") is None and
                                          info.get("state", "").rstrip("*") in ("down", "drain", "drng", "fail")):
        out.append(f"the node is '{info['state']}': jobs will wait until it is back (scontrol update ... state=resume)")
    if (info.get("cluster_nodes") or 1) > 1 and not info.get("node"):
        out.append(f"SLURM has {info['cluster_nodes']} nodes ({info.get('nodes')}) but none of them is this machine "
                   f"(by name or address): jobs cannot be kept on it; check NodeName/NodeAddr in slurm.conf")
    if info.get("SelectType", "").endswith("linear"):
        out.append("SelectType=select/linear gives each job the whole machine: studies run one at a time "
                   "(select/cons_tres lets them share it by cores; see BACKENDS.md)")
    return out


def executor_keys(keys: list[str]) -> list[str]:
    return [k for k in keys if REGISTRY[k].get("executor")]


def slurm_interactive(keys: list[str]) -> dict | None:
    """Offers to run long studies of these translators as SLURM jobs (P_EXECUTOR=slurm in config/env)."""
    keys = executor_keys(keys)
    if not keys:
        return None
    info = slurm_info()
    if info is None:
        return None
    say("\nSLURM")
    cpus = f"{info['cpus']} CPUs ({info.get('cpus_allocated', 0)} in use)" if "cpus" in info else "?"
    say(f"  {info['sbatch']}; node {info.get('nodes', '?')}: {cpus}, time limit {info.get('time_limit', '?')}, "
        f"{info.get('SelectType', '?')}")
    for n in slurm_notes(info):
        warn(n)
    if info.get("AccountingStorageType", "").endswith("none"):
        say("  No accounting (sacct): the translators judge finished jobs from their job.log, which is enough.")
    say("  As SLURM jobs, long studies from every chat share this machine through one queue, and they keep")
    say("  running when a conversation or its ssh connection ends (docs/EXECUTION.md).")
    cur = env_read()
    pre = [REGISTRY[k]["executor"]["prefix"] for k in keys]
    now = all(cur.get(f"{p}_EXECUTOR") == "slurm" for p in pre)
    if yes(f"Run long studies of {', '.join(keys)} as SLURM jobs?", True if not any(f"{p}_EXECUTOR" in cur for p in pre) else now):
        env_set({f"{p}_EXECUTOR": "slurm" for p in pre})
        for k in keys:
            st = tool_status(k) if REGISTRY[k]["status"] else None
            if st is not None and "_error" not in st and "executor" not in st:
                say(f"  note: {k} {st.get('translator', '')} does not implement it yet; the setting takes effect "
                    f"once it does (llmt update)")
    else:
        env_set({f"{p}_EXECUTOR": "local" for p in pre})
    return info


def suggest_tuning(keys: list[str], cur_env: dict[str, str]) -> tuple[dict, list[str]]:
    """Suggested config/env values: MPI ranks per study = (physical cores - a few kept free for the
    system, meshing and the servers) / concurrent studies (workers); plus the registry's fixed values."""
    cpu = cpu_info()
    reserve = 0 if cpu["physical"] <= 4 else (1 if cpu["physical"] <= 8 else 2)
    usable = max(1, cpu["physical"] - reserve)
    si = slurm_info() if any(cur_env.get(f"{REGISTRY[k]['executor']['prefix']}_EXECUTOR") == "slurm"
                             for k in executor_keys(keys)) else None
    if si and si.get("cpus") and si["cpus"] < usable:
        usable = si["cpus"]
    out, notes = {}, []
    for k in keys:
        t = REGISTRY[k].get("tuning")
        if not t:
            continue
        workers = cur_env.get(t["workers"]) or str(t["workers_default"])
        try:
            w = max(1, int(workers))
        except ValueError:
            w = t["workers_default"]
        out[t["procs"]] = str(max(1, usable // w))
        notes.append(f"{t['procs']}={out[t['procs']]}: {usable} cores ({cpu['physical']} - {reserve} kept free) "
                     f"/ {t['workers']}={w} (studies at a time" + (", the rest wait in SLURM's queue)" if si else ")"))
        for var, val in t.get("set", {}).items():
            out[var] = val
            if t.get("why"):
                notes.append(f"{var}={val}: {t['why']}")
    return out, notes


def tune_suggestions(keys: list[str]) -> tuple[dict, list[str]]:
    """What llmt tune suggests for config/env (SLURM executor when sbatch works, MPI ranks, timeouts), and why."""
    sug, lines = {}, []
    si = slurm_info() if executor_keys(keys) else None
    if si:
        lines += [f"warning: {n}" for n in slurm_notes(si)]
        if not si.get("error"):
            sug.update({f"{REGISTRY[k]['executor']['prefix']}_EXECUTOR": "slurm" for k in executor_keys(keys)})
            lines.append(f"SLURM: {si.get('cpus', '?')} CPUs on {si.get('node') or si.get('nodes', '?')}: long studies go to its queue")
            if (si.get("cluster_nodes") or 1) > 1 and si.get("node"):
                shared = si.get("shared_home")
                val = "any" if shared else "local"
                lines.append(f"cluster of {si['cluster_nodes']} nodes ({si.get('nodes')}); this machine is {si['node']}; "
                             + ("the home folder is shared: SLURM may run jobs on any node (_SLURM_NODE=any)" if shared else
                                "the home folder is not shared: jobs stay on this node (_SLURM_NODE=local), since "
                                "their run folders are only here"))
                cur = env_effective()
                for k in executor_keys(keys):
                    pre = REGISTRY[k]["executor"]["prefix"]
                    sug[f"{pre}_SLURM_NODE"] = val
                    st = tool_status(k) if REGISTRY[k]["status"] else None
                    knows = isinstance(st, dict) and isinstance(st.get("executor"), dict) and "node" in st["executor"]
                    args = cur.get(f"{pre}_SLURM_ARGS", "")
                    if val == "local" and not knows and not re.search(r"(--nodelist|-w)\b", args):
                        sug[f"{pre}_SLURM_ARGS"] = (args + " " if args else "") + f"--nodelist={si['node']}"
                        lines.append(f"  {k} does not know {pre}_SLURM_NODE yet: --nodelist={si['node']} in "
                                     f"{pre}_SLURM_ARGS until it does")
    cpu = cpu_info()
    lines.append(f"CPU: {cpu['physical']} physical cores, {cpu['logical']} logical")
    s2, notes = suggest_tuning([k for k in keys if REGISTRY[k].get("tuning")], {**env_effective(), **sug})
    sug.update(s2)
    lines += [f"  {n}" for n in notes]
    return sug, lines


def env_refresh() -> list[str]:
    """Adds the commented description of every registry variable that config/env does not mention yet (new
    since the file was written), in its translator's block. Values are never touched."""
    ensure_env_file()
    lines = ENV_FILE.read_text().splitlines()
    present = {m.group(1) for l in lines for m in [re.match(r"\s*#?\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)=", l)] if m}
    added = []
    for k, t in REGISTRY.items():
        missing = [v for v in t.get("env", {}) if v not in present]
        if not missing:
            continue
        new = [f"# {v + '=':17} # {t['env'][v]}" for v in missing]
        head = next((i for i, l in enumerate(lines) if l.startswith(f"# --- {k} (")), None)
        if head is None:
            lines += ([""] if lines and lines[-1].strip() else []) + [f"# --- {k} ({t['repo']})"] + new
        else:
            j = head + 1
            while j < len(lines) and lines[j].strip():
                j += 1
            lines[j:j] = new
        added += missing
    if added:
        ENV_FILE.write_text("\n".join(lines) + "\n")
    return added


def auto_tune(keys: list[str]) -> None:
    """After install/update: config/env gets llmt tune's suggestions for the settings it does not have yet.
    Values already set (also 'local' or an empty value) are kept; differences are only reported."""
    keys = [k for k in keys if REGISTRY[k].get("tuning") or REGISTRY[k].get("executor")]
    added = env_refresh()
    if not keys and not added:
        return
    say("\nSettings for this machine (config/env)")
    if added:
        say(f"  described the new settings {', '.join(added)} (commented out)")
    if not keys:
        return
    sug, lines = tune_suggestions(keys)
    cur = env_read()
    fill = {v: x for v, x in sug.items() if v not in cur}
    differ = {v: (cur[v], x) for v, x in sug.items() if v in cur and cur[v] != x}
    if fill:
        for line in lines:
            say(f"  {line.strip()}" if not line.startswith("  ") else line)
        env_set(fill)
        for v, x in fill.items():
            say(f"  set {v}={x}")
    for v, (have, want) in differ.items():
        say(f"  kept {v}={have or '(empty)'} (llmt tune suggests {want}: llmt tune --apply takes it)")
    if not fill and not differ:
        say("  as llmt tune suggests")


def tune_interactive(keys: list[str]) -> None:
    env_refresh()
    slurm_interactive(keys)
    keys = [k for k in keys if REGISTRY[k].get("tuning")]
    if not keys:
        return
    cur = env_read()
    cpu = cpu_info()
    sug, notes = suggest_tuning(keys, cur)
    say("\nRun limits for this machine (config/env)")
    kinds = " (" + " + ".join(f"{n} {name}" for n, name in cpu["kinds"]) + ")" if cpu["kinds"] else ""
    say(f"  CPU: {cpu['physical']} physical cores{kinds}, {cpu['logical']} logical")
    if cpu["kinds"]:
        say("  Mixed core types: MPI ranks on efficiency cores run slower and the others wait for them;")
        say("  if a benchmark runs as fast with fewer ranks, use the number of performance cores.")
    for n in notes:
        say(f"  {n}")
    rows = []
    for var, val in sug.items():
        have = cur.get(var)
        rows.append((var, val, have))
        say(f"    {var:14} suggested {val:7}" + (f" current {have}" if have else ""))
    if all(have == val for _, val, have in rows):
        say("  config/env already has these.")
        return
    if yes("Write the suggested values to config/env (values you set before are replaced)?", True):
        env_set({var: val for var, val, _ in rows})
    elif yes("Set them one by one?", True):
        for k in keys:
            t = REGISTRY[k]["tuning"]
            w = ask(f"{t['workers']} (studies at a time)", cur.get(t["workers"]) or str(t["workers_default"]))
            env_set({t["workers"]: w})
            sug2, _ = suggest_tuning([k], {**cur, t["workers"]: w})
            v = ask(f"{t['procs']} (MPI ranks per study; '-' clears)", sug2[t["procs"]])
            env_set({t["procs"]: "" if v == "-" else v})
            for var, val in t.get("set", {}).items():
                v = ask(f"{var} ('-' clears)", cur.get(var) or val)
                env_set({var: "" if v == "-" else v})
    else:
        return
    say(f"  {ENV_FILE} updated. Per study, a 'procs' in the study itself still overrides it; so do")
    say("  VAR=value settings in an MCP entry (llmt mcp setup).")


# ---------------------------------------------------------------- shell alias

ALIAS_NAME = "llmt-venv"
ALIAS_BEGIN = "# >>> llm-translators >>>"
ALIAS_END = "# <<< llm-translators <<<"
RC_FILES = [".bashrc", ".bash_aliases", ".bash_profile", ".profile", ".zshrc"]
_OLD_ALIAS = re.compile(r"^\s*alias\s+([A-Za-z0-9_.-]+)=(['\"]?)\s*(?:source|\.)\s+(\S*(?:%s)/\.venv/bin/activate)\s*\2\s*$"
                        % "|".join(re.escape(t["repo"]) for t in REGISTRY.values()))


def default_rc() -> Path:
    return Path.home() / (".zshrc" if os.path.basename(os.environ.get("SHELL", "")) == "zsh" else ".bashrc")


def alias_line(name: str) -> str:
    try:
        p = "~/" + str(ENTRY_ROOT.relative_to(Path.home()))
    except ValueError:
        p = str(ENTRY_ROOT)
    if re.search(r"[^\w@%+=:,./~-]", p):
        return f"alias {name}='source \"{ENTRY_ROOT}/bin/activate\"'"
    return f"alias {name}='source {p}/bin/activate'"


def old_aliases() -> list[tuple[Path, int, str, str]]:
    """Aliases in the shell startup files that activate a translator's own venv (the earlier layout,
    e.g. alias cad='source ~/Software/build123d-translator/.venv/bin/activate')."""
    out = []
    for f in RC_FILES:
        p = Path.home() / f
        try:
            lines = p.read_text().splitlines()
        except (OSError, UnicodeDecodeError):
            continue
        for i, line in enumerate(lines):
            m = _OLD_ALIAS.match(line)
            if m:
                out.append((p, i, m.group(1), m.group(3)))
    return out


def install_alias(name: str, rc: Path, comment_old: bool) -> None:
    """Writes 'alias NAME=source <root>/bin/activate' in a marked block of rc (replacing an earlier
    block) and comments out the old translator-venv aliases. Each changed file is backed up first."""
    stamp = f"{_dt.datetime.now():%Y%m%d-%H%M%S}"
    old = old_aliases() if comment_old else []
    files = sorted({p for p, *_ in old} | {rc})
    for f in files:
        text = f.read_text() if f.exists() else ""
        lines = text.splitlines()
        new = list(lines)
        for p, i, oname, path in old:
            if p == f:
                new[i] = f"# {lines[i]}   # replaced by '{name}' (llm-translators)"
                say(f"  {f}: commented out the old alias '{oname}' ({path})")
        if f == rc:
            if ALIAS_BEGIN in new and ALIAS_END in new:
                a, b = new.index(ALIAS_BEGIN), new.index(ALIAS_END)
                new = new[:a] + new[b + 1:]
                while new and not new[-1].strip():
                    new.pop()
            block = [ALIAS_BEGIN, "# the llm-translators venv and its settings", alias_line(name), ALIAS_END]
            new += ([""] if new else []) + block
            say(f"  {f}: {alias_line(name)}")
        if new != lines:
            if f.exists():
                shutil.copy2(f, f.with_name(f.name + f".bak-llmt-{stamp}"))
            f.write_text("\n".join(new) + "\n")
    say(f"  Open a new shell (or 'source {rc}'), then '{name}' activates the environment; 'deactivate' leaves it.")


def alias_interactive(setup: dict) -> None:
    old = old_aliases()
    prev = setup.get("alias", {})
    say("\nShell alias")
    for p, i, oname, path in old:
        say(f"  {p} line {i + 1}: alias '{oname}' activates {path} (the earlier layout)")
    if not yes(f"Add an alias that activates llm-translators' venv to your shell startup file?", bool(old) or not prev):
        return
    name = ask("alias name", prev.get("name", ALIAS_NAME))
    rc = Path(ask("in", prev.get("rc", str(default_rc())))).expanduser()
    comment = bool(old) and yes(f"Comment out the old alias{'es' if len(old) > 1 else ''} ({', '.join(o[2] for o in old)})?", True)
    install_alias(name, rc, comment)
    setup["alias"] = {"name": name, "rc": str(rc)}
    save_setup(setup)


# ---------------------------------------------------------------- status

def tool_status(key: str, timeout: float = 120) -> dict | None:
    t = REGISTRY[key]
    if not t["status"]:
        return None
    try:
        r = subprocess.run([str(ROOT / "bin" / "run"), t["cli"], "status"], capture_output=True, text=True, timeout=timeout)
        return json.loads(r.stdout) if r.returncode == 0 else {"_error": (r.stderr or r.stdout).strip()[-300:]}
    except subprocess.TimeoutExpired:
        return {"_error": f"'{t['cli']} status' timed out"}
    except json.JSONDecodeError:
        return {"_error": f"'{t['cli']} status' did not print JSON"}


def backend_found(val) -> tuple[bool, str]:
    if val is None or val is False:
        return False, "not found"
    if isinstance(val, dict):
        if val.get("error"):
            return False, str(val["error"])
        for k in ("version", "exe", "foamRun", "bashrc"):
            if val.get(k):
                return True, str(val[k])
        return True, "found"
    if isinstance(val, str) and val.startswith("/") and not os.path.exists(val):
        return False, f"{val} does not exist"
    return True, str(val)


def backend_report(key: str, st: dict | None) -> list[tuple[str, bool, str, dict]]:
    out = []
    for b in REGISTRY[key]["backends"]:
        if st is None or "_error" in st:
            out.append((b["name"], False, (st or {}).get("_error", "no status"), b))
        else:
            ok, what = backend_found(st.get(b["key"]))
            out.append((b["name"], ok, what, b))
    return out


def status_data(keys: list[str] | None = None) -> dict:
    setup = load_setup()
    inst = installed_in_venv()
    subs = submodule_states()
    keys = keys or KEYS
    data = {"llmt": __version__, "root": str(ROOT), "venv": str(VENV) if VPY.exists() else None,
            "python": venv_python_version(), "translators": {},
            "mode": "release" if SHARED else "checkout", "release": release_info() if SHARED else None,
            "settings": [str(f) for f in ([SYSTEM_ENV] if SYSTEM_ENV.exists() else []) + [ENV_FILE] if f.exists()]}
    si = slurm_info()
    if si:
        data["slurm"] = {**si, "jobs": slurm_jobs()}
    for k in keys:
        t = REGISTRY[k]
        state, commit = subs.get(t["repo"], ("absent", ""))
        d = {"repo": t["repo"], "submodule": state, "commit": commit, "version": inst.get(k),
             "selected": k in setup.get("installed", [])}
        if k in inst:
            st = tool_status(k)
            d["backends"] = {name: {"found": ok, "detail": what} for name, ok, what, _ in backend_report(k, st)}
            d["status"] = st
            ex = REGISTRY[k].get("executor")
            if ex:
                want = env_effective().get(f"{ex['prefix']}_EXECUTOR", "local")
                d["executor"] = {"setting": want, "supported": isinstance(st, dict) and "executor" in st,
                                 "reported": (st or {}).get("executor") if isinstance(st, dict) else None}
        data["translators"][k] = d
    return data


def print_status(data: dict, verbose: bool) -> None:
    if data.get("mode") == "release":
        rel = data.get("release") or {}
        say(f"llm-translators shared release {rel.get('release', '?')} ({data['root']}; llmt {data['llmt']}, "
            f"built {rel.get('created', '?')} by {rel.get('built_by', '?')})")
    else:
        say(f"llm-translators {data['llmt']}  ({data['root']})")
    if data.get("settings"):
        say("settings: " + ", then ".join(data["settings"]))
    say(f"venv: {data['venv'] or 'none (llmt setup)'}" + (f"  Python {data['python']}" if data["python"] else ""))
    say("")
    say(f"  {'key':5} {'version':14} {'commit':8} {'submodule':10} backends")
    for k, d in data["translators"].items():
        if not d["version"]:
            note = ("not in this release" if data.get("mode") == "release" else
                    "not installed" if d["submodule"] == "absent" else "checked out, not installed")
            say(f"  {k:5} {'-':14} {d['commit'] or '-':8} {d['submodule']:10} {note}")
            continue
        bes = d.get("backends", {})
        parts = [f"{n}: {'ok' if v['found'] else 'MISSING'}" for n, v in bes.items()] or ["none needed"]
        say(f"  {k:5} {d['version']:14} {d['commit']:8} {d['submodule']:10} " + "; ".join(parts))
        for n, v in bes.items():
            if verbose or (not v["found"] and v["detail"] != "not found"):
                say(f"{'':43}{n}: {v['detail']}")
        ex = d.get("executor")
        if ex and (ex["setting"] != "local" or ex["supported"]):
            if ex["setting"] == "slurm" and not ex["supported"]:
                say(f"{'':43}runs: {k.upper()} executor 'slurm' set, but this version ignores it (docs/EXECUTION.md)")
            else:
                say(f"{'':43}runs: {ex['setting']}" + (" (SLURM jobs)" if ex["setting"] == "slurm" else ""))
        if verbose and d.get("status"):
            say("  " + json.dumps(d["status"], indent=1).replace("\n", "\n  "))
    sl = data.get("slurm")
    if sl:
        jobs = sl.get("jobs", [])
        run_ = sum(1 for j in jobs if j["state"] == "RUNNING")
        say(f"\nSLURM: {sl.get('cpus', '?')} CPUs, {sl.get('cpus_allocated', '?')} in use; translator jobs: "
            f"{run_} running, {len(jobs) - run_} waiting (llmt jobs)")
        for n in slurm_notes(sl):
            say(f"  ! {n}")
    missing = [(k, n) for k, d in data["translators"].items() for n, v in d.get("backends", {}).items() if not v["found"]]
    if missing:
        say(f"\nMissing backends are installed separately: see {BACKENDS_MD}. Paths go in config/env (llmt env --edit).")
    moved = [k for k, d in data["translators"].items() if d["submodule"] == "moved"]
    if moved:
        say(f"\nNot at the commit the umbrella pins: {', '.join(moved)} (llmt update to go back, or commit the new pins).")


# ---------------------------------------------------------------- MCP

def claude_desktop_config() -> Path:
    home = Path.home()
    if sys.platform == "darwin":
        return home / "Library" / "Application Support" / "Claude" / "claude_desktop_config.json"
    if os.name == "nt":
        return Path(os.environ.get("APPDATA", home)) / "Claude" / "claude_desktop_config.json"
    return home / ".config" / "Claude" / "claude_desktop_config.json"


SSH_OPTS = ["-T", "-o", "BatchMode=yes"]


def ssh_exe() -> str:
    return shutil.which("ssh") or "/usr/bin/ssh"


def entry_text(e: dict) -> str:
    s = " ".join([str(e.get("command", ""))] + [str(x) for x in e.get("args", [])])
    if e.get("env"):
        s += "  (env: " + " ".join(f"{k}={v}" for k, v in e["env"].items()) + ")"
    return s


def is_managed(e: dict) -> bool:
    """Entries llmt writes run llm-translators' bin/mcp (or bin/router)."""
    t = entry_text(e)
    return "/bin/mcp" in t or "/bin/router" in t


def mcp_entry(key: str, spec: dict) -> dict:
    w = spec.get("where")
    sets = spec.get("env", {})
    if w == "remote":  # ssh joins the arguments into one remote shell command: quote the values
        root = spec.get("root", "~/Software/llm-translators").rstrip("/")
        return {"command": ssh_exe(), "args": [*SSH_OPTS, spec["host"], f"{root}/bin/mcp", key,
                                               *[f"{k}={shlex.quote(v)}" for k, v in sets.items()]]}
    if w == "existing":
        return dict(spec["entry"])
    if w == "router":
        return {"command": str(ENTRY_ROOT / "bin" / "router"), "args": [key]}
    return {"command": str(ENTRY_ROOT / "bin" / "mcp"), "args": [key, *[f"{k}={v}" for k, v in sets.items()]]}


def mcp_entries(setup: dict) -> dict:
    return {k: mcp_entry(k, s) for k, s in setup.get("mcp", {}).items()
            if s.get("where") in ("local", "remote", "existing", "router")}


def existing_entry(path: str, host: str | None, env: dict[str, str]) -> dict:
    """An MCP entry for a translator installed outside llm-translators (its own venv, no config/env)."""
    if host:
        pre = ["env", *[f"{k}={shlex.quote(v)}" for k, v in env.items()]] if env else []
        return {"command": ssh_exe(), "args": [*SSH_OPTS, host, *pre, path]}
    e = {"command": path, "args": []}
    if env:
        e["env"] = dict(env)
    return e


def desktop_servers() -> dict:
    p = claude_desktop_config()
    try:
        return json.loads(p.read_text() or "{}").get("mcpServers", {}) if p.exists() else {}
    except (OSError, json.JSONDecodeError):
        return {}


_PROBE = r'''
root={root}
echo "ROOT $root"
if [ -x "$root/llmt" ]; then echo "LLMT"; fi
if [ -x /opt/llm-translators/current/llmt ]; then echo "SHARED /opt/llm-translators/current"; fi
for k in {keys}; do
  for p in "$(command -v $k-mcp 2>/dev/null)" "$HOME"/Software/*/.venv/bin/$k-mcp "$HOME"/Software/*/venv/bin/$k-mcp \
           "$HOME"/*/.venv/bin/$k-mcp "$HOME"/Desktop/*/.venv/bin/$k-mcp "$HOME"/.local/bin/$k-mcp; do
    if [ -n "$p" ] && [ -x "$p" ]; then echo "MCP $k $p"; fi
  done
done
'''

_PROBES: dict = {}


def probe(host: str | None, root: str, keys: list[str] | None = None) -> dict | None:
    """Looks on this machine (host None) or over ssh for llm-translators at root and for translators
    installed elsewhere (<key>-mcp in other venvs: the layout before llm-translators).
    -> {"root": expanded root, "llmt": bool, "found": {key: [paths outside root/.venv]}} or None."""
    keys = keys or KEYS
    cache = (host, root, tuple(keys))
    if cache in _PROBES:
        return _PROBES[cache]
    r_ = root.rstrip("/")
    r_ = '"$HOME' + r_[1:] + '"' if r_.startswith("~") else shlex.quote(r_)
    script = _PROBE.replace("{root}", r_).replace("{keys}", " ".join(keys))
    cmd = ["sh", "-s"] if host is None else [ssh_exe(), *SSH_OPTS, "-o", "ConnectTimeout=10", host, "sh -s"]
    try:
        r = subprocess.run(cmd, input=script, capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired) as exc:
        warn(f"could not reach {host}: {exc}")
        _PROBES[cache] = None
        return None
    if r.returncode != 0 and "ROOT " not in r.stdout:
        warn(f"{host or 'this machine'}: {(r.stderr or r.stdout).strip()[-300:] or 'failed'}")
        _PROBES[cache] = None
        return None
    out = {"root": root, "llmt": False, "found": {}}
    for line in r.stdout.splitlines():
        if line.startswith("ROOT "):
            out["root"] = line[5:]
        elif line == "LLMT":
            out["llmt"] = True
        elif line.startswith("SHARED "):
            out["shared"] = line[7:]
        elif line.startswith("MCP "):
            _, k, p = line.split(" ", 2)
            if not p.startswith(out["root"].rstrip("/") + "/.venv/") and "/llm-translators/releases/" not in p:
                lst = out["found"].setdefault(k, [])
                if p not in lst:
                    lst.append(p)
    _PROBES[cache] = out
    return out


_REMOTE_STATUS: dict = {}


def remote_status(host: str, root: str) -> dict | None:
    """llmt status --json on host (cached)."""
    if (host, root) in _REMOTE_STATUS:
        return _REMOTE_STATUS[(host, root)]
    cmd = [ssh_exe(), *SSH_OPTS, "-o", "ConnectTimeout=10", host, "python3", f"{root}/llmt", "status", "--json"]
    say(f"  checking llm-translators on {host} ...")
    data = None
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=300)
        if r.returncode == 0:
            data = json.loads(r.stdout)
        else:
            warn(f"{host}: {(r.stderr or r.stdout).strip()[-300:] or 'llmt status failed'}")
    except (OSError, subprocess.TimeoutExpired, json.JSONDecodeError) as exc:
        warn(f"{host}: {exc}")
    _REMOTE_STATUS[(host, root)] = data
    return data


def ask_env(key: str, default: dict[str, str] | None = None, note: str | None = None) -> dict[str, str]:
    """Settings that go into the MCP entry itself (VAR=value ...)."""
    names = ", ".join(REGISTRY[key]["env"]) or "none known"
    cur = " ".join(f"{k}={shlex.quote(v)}" for k, v in (default or {}).items())
    say(note or f"  An install outside llm-translators does not read config/env: settings go into the entry ({names}).")
    while True:
        text = ask("settings, VAR=value separated by spaces (empty: none)", cur)
        try:
            pairs = shlex.split(text)
        except ValueError as exc:
            warn(str(exc))
            continue
        bad = [p for p in pairs if not re.match(r"[A-Za-z_][A-Za-z0-9_]*=", p)]
        if bad:
            warn(f"not VAR=value: {' '.join(bad)}")
            continue
        return dict(p.split("=", 1) for p in pairs)


def pick_path(key: str, found: list[str], where: str) -> str:
    if found:
        for i, p in enumerate(found, 1):
            say(f"    {i}. {p}")
        a = ask(f"{key}-mcp to use (number or path)", "1")
        if a.isdigit() and 1 <= int(a) <= len(found):
            return found[int(a) - 1]
        return a
    p = ""
    while not p:
        p = ask(f"path of {key}-mcp on {where}", "")
    return p


def choose_existing(key: str, current: dict | None, last_host: str) -> dict | None:
    """[e]xisting: keep the current entry, or point at a translator installed outside llm-translators."""
    if current and not is_managed(current):
        if yes(f"Keep the current entry ({entry_text(current)})?", True):
            return {"where": "existing", "entry": current}
    host = ask("where is it installed? user@host for ssh, empty for this machine", last_host) or None
    found = []
    if host is None or yes(f"Look for installs on {host} now (ssh)?", True):
        info = probe(host, "~/Software/llm-translators")
        found = (info or {}).get("found", {}).get(key, [])
        if not found:
            say(f"  no {key}-mcp found in the usual places on {host or 'this machine'}")
    path = pick_path(key, found, host or "this machine")
    env = ask_env(key)
    return {"where": "existing", "host": host, "entry": existing_entry(path, host, env)}


def report_remote(key: str, host: str, root: str, spec: dict) -> dict:
    """After choosing [r]emote: checks host; if llm-translators or the translator is missing there but
    an older install of it is found, offers to use that one meanwhile. Returns the spec to keep."""
    info = probe(host, root)
    if info is None:
        warn(f"{host} not reachable now: the entry is written anyway; check later with 'llmt mcp setup'")
        return spec
    old = info["found"].get(key, [])
    if info["llmt"]:
        data = remote_status(host, root)
        d = (data or {}).get("translators", {}).get(key, {})
        if d.get("version"):
            miss = [n for n, v in d.get("backends", {}).items() if not v["found"]]
            procs = (d.get("status") or {}).get("procs")
            say(f"  {host}: {key} {d['version']} in llm-translators" +
                (f"; missing: {', '.join(miss)} (see BACKENDS.md)" if miss else "; backends ok") +
                (f"; {procs} MPI ranks per study (its config/env)" if procs else ""))
            return spec
        warn(f"{key} is not installed in llm-translators on {host} (there: {root}/llmt install {key})")
    else:
        warn(f"llm-translators is not at {root} on {host}")
    if old:
        say(f"  {host} has {key} installed outside llm-translators:")
        if yes(f"Use that install for now (until llm-translators is set up there)?", True):
            path = pick_path(key, old, host)
            return {"where": "existing", "host": host, "entry": existing_entry(path, host, ask_env(key))}
    say(f"  Set it up on {host} before restarting the Claude app: clone llm-translators to {root}, "
        f"then '{root}/llmt install {key}'.")
    return spec


def entry_settings(key: str, prev: dict, where: str) -> dict:
    """Optional settings for one MCP server (e.g. CFDT_TIMEOUT=10800 CFDT_PROCS=18), passed as
    bin/mcp KEY VAR=value ...: they apply to this entry only and override config/env on that machine."""
    cur = prev.get("env", {}) if prev.get("where") in ("local", "remote") else {}
    names = ", ".join(REGISTRY[key]["env"])
    if not names:
        return {}
    if not cur and not yes(f"Settings for this {key} server (override {where}'s config/env: {names})?", False):
        return {}
    env = ask_env(key, cur, note=f"  VAR=value pairs for this {key} server only; config/env on {where} has the defaults.")
    return {"env": env} if env else {}


def mcp_setup_interactive(setup: dict, hint: dict | None = None) -> None:
    """hint: the placement chosen in setup's step 1 (here / remote / none), used for the defaults."""
    say("\nMCP servers for the Claude app on THIS machine. For each translator:")
    say("  a = auto: one server that places each run on the best of several machines (llmt router, docs/ROUTER.md)")
    say("  l = local (llm-translators here)    r = remote (llm-translators on another machine, over ssh)")
    say("  e = existing (an install outside llm-translators, here or over ssh)    n = none")
    mcp = setup.setdefault("mcp", {})
    inst = set(installed_in_venv())
    current = desktop_servers()
    here = probe(None, str(ROOT)) or {"found": {}}
    last_host, last_root = "", "~/Software/llm-translators"
    for s in mcp.values():
        if s.get("where") == "remote":
            last_host, last_root = s.get("host", last_host), s.get("root", last_root)
        elif s.get("where") == "existing" and s.get("host"):
            last_host = s["host"]
    for k in KEYS:
        t = REGISTRY[k]
        cur_entry = current.get(k)
        prev = mcp.get(k, {})
        h = (hint or {}).get(k)
        if h == "here":
            default = "e" if prev.get("where") == "existing" and k not in inst else "l"
        elif h == "remote":
            default = "e" if prev.get("where") == "existing" and prev.get("host") else "r"
        elif h == "none":
            default = "n"
        elif prev.get("where"):
            default = {"local": "l", "remote": "r", "existing": "e", "router": "a", "none": "n"}[prev["where"]]
        elif cur_entry and not is_managed(cur_entry):
            default = "e"
        else:
            default = "l" if k in inst else "n"
        say(f"\n  {k} ({t['repo']}): {t['cost']}" + ("" if k in inst else "  [not in llm-translators here]"))
        if cur_entry:
            say(f"  current entry{'' if is_managed(cur_entry) else ' (not from llmt)'}: {entry_text(cur_entry)}")
        while True:
            a = ask(f"{k}: [l]ocal, [r]emote, [a]uto (several machines), [e]xisting, [n]one", default).lower()[:1]
            if a in ("l", "r", "a", "e", "n"):
                break
        if a == "l":
            if k not in inst:
                old = here["found"].get(k, [])
                warn(f"{k} is not installed in llm-translators here yet: llmt install {k}" +
                     (f" (or choose [e]xisting for {old[0]})" if old else ""))
            mcp[k] = {"where": "local", **entry_settings(k, prev, "this machine")}
        elif a == "r":
            host = ask("ssh host (user@host, keys set up for BatchMode)", prev.get("host", last_host))
            while not host:
                host = ask("ssh host (user@host)", "")
            check = yes(f"Check {host} now (ssh)?", True)
            guess = prev.get("root", last_root)
            info = probe(host, guess) if check else None
            if info and not info["llmt"] and info.get("shared"):
                say(f"  {host} has a shared install, kept up to date by its admin: {info['shared']} (docs/SHARED.md)")
                guess = info["shared"]
            root = ask(f"llm-translators folder on {host}", guess)
            spec = {"where": "remote", "host": host, "root": root, **entry_settings(k, prev, host)}
            if check:
                spec = report_remote(k, host, root, spec)
            mcp[k] = spec
            last_host, last_root = host, root
        elif a == "a":
            if not (setup.get("router") or {}).get("hosts"):
                say("  The router needs the machines it may use (docs/ROUTER.md):")
                router_hosts_interactive(setup)
            have = [n for n, keys in router_overview(setup).items() if k in keys]
            if not have:
                warn(f"no router machine has {k} installed yet (llmt router setup)")
            else:
                say(f"  {k} on: {', '.join(have)}")
            mcp[k] = {"where": "router"}
        elif a == "e":
            spec = choose_existing(k, cur_entry, last_host)
            if spec:
                mcp[k] = spec
                last_host = spec.get("host") or last_host
        else:
            mcp[k] = {"where": "none"}
    save_setup(setup)
    entries = mcp_entries(setup)
    if not entries:
        say("\n  No MCP servers chosen for this machine.")
        return
    if any(s_.get("where") == "local" for s_ in mcp.values()):
        show_macos_warnings()
    say("\nEntries:")
    say(json.dumps({"mcpServers": entries}, indent=1))
    path = claude_desktop_config()
    if yes(f"Write them into the Claude desktop config ({path})? A backup is kept.", True):
        write_desktop_config(entries, path, [k for k, s in mcp.items() if s.get("where") == "none"])
    else:
        say("  Later: llmt mcp config   (or --print, --claude-code)")
    if yes("Test each server now, the way the Claude app starts it?", True):
        mcp_test(list(entries), setup, 180)
    ext = [k for k, s in mcp.items() if s.get("where") == "existing"]
    if ext:
        say(f"\n  {', '.join(ext)}: using installs outside llm-translators. To move them over later, set up")
        say("  llm-translators there and choose [l]ocal or [r]emote here ('llmt mcp setup').")


def write_desktop_config(entries: dict, path: Path, drop: list[str]) -> None:
    cfg = {}
    if path.exists():
        try:
            cfg = json.loads(path.read_text() or "{}")
        except json.JSONDecodeError:
            die(f"{path} is not valid JSON; fix it or use llmt mcp config --print")
        bak = path.with_name(path.name + f".bak-{_dt.datetime.now():%Y%m%d-%H%M%S}")
        shutil.copy2(path, bak)
        say(f"  backup: {bak}")
    servers = cfg.setdefault("mcpServers", {})
    for k, e in entries.items():
        old = servers.get(k)
        if old == e:
            say(f"  {k}: unchanged")
            continue
        if old:
            say(f"  {k}: {' '.join([old.get('command', '')] + old.get('args', []))}")
            say(f"  {'':{len(k)}}  -> {' '.join([e['command']] + e['args'])}")
        else:
            say(f"  {k}: added")
        servers[k] = e
    for k in drop:  # only entries llmt wrote (they run bin/mcp); others with the same name are left alone
        e = servers.get(k)
        if e and is_managed(e):
            say(f"  {k}: removed (set to none)")
            servers.pop(k)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(cfg, indent=2) + "\n")
    say(f"  wrote {path}. Restart the Claude app to load the servers.")


def is_ssh(entry: dict) -> bool:
    return os.path.basename(str(entry.get("command", ""))) == "ssh"


def macos_launch_warnings() -> list[str]:
    """Things that let llmt start the servers from Terminal but make macOS refuse them to the Claude app
    ('/bin/sh: .../bin/mcp: Operation not permitted' in ~/Library/Logs/Claude/mcp-server-KEY.log)."""
    if sys.platform != "darwin":
        return []
    out = []
    home = Path.home()
    for d in ("Desktop", "Documents", "Downloads", "Library/Mobile Documents"):
        if str(ROOT).startswith(str(home / d) + "/"):
            out.append(f"llm-translators is in ~/{d}, a folder macOS protects: the Claude app can be refused when it "
                       f"starts bin/mcp ('Operation not permitted'), although Terminal can run it. Move it, e.g. to "
                       f"~/Software/llm-translators (README: 'Moving llm-translators').")
    marked = []
    for f in (ROOT / "bin" / "mcp", ROOT / "bin" / "run", ROOT / "llmt"):
        try:
            if subprocess.run(["xattr", "-p", "com.apple.quarantine", str(f)], capture_output=True).returncode == 0:
                marked.append(f.name)
        except OSError:
            pass
    if marked:
        out.append(f"{', '.join(marked)} carry macOS's quarantine flag; clear it with: xattr -dr com.apple.quarantine {ROOT}")
    return out


def show_macos_warnings() -> None:
    for w in macos_launch_warnings():
        warn(w)


def mcp_test_one(key: str, entry: dict, timeout: float = 180) -> bool:
    """Starts the server the way the Claude app does (its command and args, a bare environment: the app
    does not read your shell's startup files), does the MCP handshake and lists the tools."""
    env = {k: os.environ[k] for k in ("HOME", "USER", "LOGNAME", "LANG", "TMPDIR", "SSH_AUTH_SOCK") if k in os.environ}
    env["PATH"] = "/usr/bin:/bin:/usr/sbin:/sbin"
    env.update(entry.get("env") or {})
    cmd = [entry["command"], *[str(x) for x in entry.get("args", [])]]
    say(f"\n  {key}: {entry_text(entry)}")
    t0 = time.monotonic()
    try:
        p = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=env)
    except OSError as exc:
        say(f"    FAILED to start: {exc}")
        return False
    err: list[str] = []
    out: list[bytes] = []
    got = threading.Event()

    def pump_err():
        for line in p.stderr:
            err.append(line.decode(errors="replace").rstrip())

    def pump_out():
        for line in p.stdout:
            out.append(line)
            got.set()
        got.set()
    threading.Thread(target=pump_err, daemon=True).start()
    threading.Thread(target=pump_out, daemon=True).start()

    def send(obj):
        p.stdin.write((json.dumps(obj) + "\n").encode())
        p.stdin.flush()

    def wait_for(id_, until):
        while time.monotonic() < until:
            while out:
                raw = out.pop(0)
                try:
                    msg = json.loads(raw)
                except json.JSONDecodeError:
                    return {"_bad": raw.decode(errors="replace").strip()[:200]}
                if msg.get("id") == id_:
                    return msg
            if p.poll() is not None and not out:
                return None
            got.wait(0.2)
            got.clear()
        return {"_timeout": True}

    ok = False
    try:
        send({"jsonrpc": "2.0", "id": 1, "method": "initialize",
              "params": {"protocolVersion": "2025-06-18", "capabilities": {},
                         "clientInfo": {"name": "llmt", "version": __version__}}})
        r = wait_for(1, t0 + timeout)
        if r and "result" in r:
            t_init = time.monotonic() - t0
            info = r["result"].get("serverInfo", {})
            send({"jsonrpc": "2.0", "method": "notifications/initialized"})
            send({"jsonrpc": "2.0", "id": 2, "method": "tools/list"})
            r2 = wait_for(2, time.monotonic() + 60)
            tools = (r2 or {}).get("result", {}).get("tools", [])
            ok = bool(tools)
            if "llmt-router" in str(info.get("name", "")) and len(tools) <= 1:
                ok = False
                say("    FAILED: the router reached no machine (only its machines() tool); llmt router status shows why")
            say(f"    {'ok' if ok else 'NO TOOLS'}: {info.get('name', '?')} {info.get('version', '')}, "
                f"{len(tools)} tools, started in {t_init:.1f} s")
            if t_init > 30:
                say("    slow start: the Claude app may give up waiting; start it once by hand to compile the caches")
        elif r and "_bad" in r:
            say(f"    FAILED: the server printed something that is not MCP on stdout: {r['_bad']}")
        elif r and "_timeout" in r:
            say(f"    FAILED: no answer within {timeout:.0f} s")
        else:
            say(f"    FAILED: the server exited (code {p.poll()}) before answering")
    except BrokenPipeError:
        say(f"    FAILED: the server exited (code {p.poll()}) before reading its input")
    finally:
        try:
            p.stdin.close()
        except OSError:
            pass
        try:
            p.wait(timeout=5)
        except subprocess.TimeoutExpired:
            p.kill()
        time.sleep(0.2)
    if not ok and err:
        say("    its stderr (last lines):")
        for line in err[-25:]:
            say(f"      {line}")
    return ok


def mcp_test(keys: list[str] | None, setup: dict, timeout: float) -> bool:
    entries = mcp_entries(setup)
    desk = desktop_servers()
    keys = keys or [k for k in KEYS if k in entries or k in desk]
    if not keys:
        die("no MCP entries to test (llmt mcp setup)")
    if any(not is_ssh(entries.get(k) or desk.get(k) or {}) for k in keys):
        show_macos_warnings()
        if sys.platform == "darwin":
            say("  (This test runs from Terminal, which macOS treats differently from the Claude app: if it")
            say("  passes but the app fails, check ~/Library/Logs/Claude/mcp-server-KEY.log.)")
    results = {}
    for k in keys:
        e = entries.get(k) or desk.get(k)
        if not e:
            say(f"\n  {k}: no entry (llmt mcp setup)")
            results[k] = False
            continue
        if desk.get(k) and entries.get(k) and desk[k] != entries[k]:
            say(f"\n  {k}: the Claude config differs from llmt's choice (llmt mcp config to write it); testing the Claude config")
            e = desk[k]
        results[k] = mcp_test_one(k, e, timeout)
    say("\n  " + "  ".join(f"{k}: {'ok' if v else 'FAILED'}" for k, v in results.items()))
    if not all(results.values()):
        say(f"  The Claude app's own log: {Path.home() / 'Library/Logs/Claude'}/mcp-server-KEY.log (macOS)")
    return all(results.values())


def mcp_serve(keys: list[str], host: str) -> None:
    if host not in ("127.0.0.1", "localhost"):
        warn("streamable HTTP has no authentication: serve on trusted networks or through a tunnel only")
    procs = []
    for k in keys:
        port = REGISTRY[k]["port"]
        say(f"  {k}: http://{host}:{port}/mcp")
        procs.append((k, subprocess.Popen([str(ROOT / "bin" / "mcp"), k, "--http", str(port), "--host", host])))
    say("  Ctrl-C stops them.")

    def stop(*_):
        for _, p in procs:
            if p.poll() is None:
                p.terminate()
    signal.signal(signal.SIGTERM, lambda *a: (stop(), sys.exit(0)))
    try:
        while procs:
            for k, p in list(procs):
                rc = p.poll()
                if rc is not None:
                    warn(f"{k} exited ({rc})")
                    procs.remove((k, p))
            if procs:
                try:
                    procs[0][1].wait(timeout=1)
                except subprocess.TimeoutExpired:
                    pass
    except KeyboardInterrupt:
        stop()
        for _, p in procs:
            try:
                p.wait(timeout=10)
            except subprocess.TimeoutExpired:
                p.kill()


