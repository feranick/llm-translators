def host_overview(h: dict) -> dict:
    """{key: version} of the translators installed at a router machine (None: unreachable)."""
    r_ = h["root"].rstrip("/")
    r_ = '"$HOME' + r_[1:] + '"' if r_.startswith("~") else shlex.quote(r_)
    script = f'r={r_}; python3 "$r/llmt" status --json'
    cmd = ([ssh_exe(), *SSH_OPTS, "-o", "ConnectTimeout=10", h["ssh"], script] if h.get("ssh")
           else ["sh", "-c", script])
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=180)
        data = json.loads(r.stdout)
    except (OSError, subprocess.TimeoutExpired, json.JSONDecodeError):
        return None
    return {k: d.get("version") for k, d in data.get("translators", {}).items() if d.get("version")}


_OVERVIEW: dict = {}


def router_overview(setup: dict) -> dict:
    out = {}
    for h in (setup.get("router") or {}).get("hosts", []):
        key = (h["name"], h.get("ssh"), h["root"])
        if key not in _OVERVIEW:
            _OVERVIEW[key] = host_overview(h)
        out[h["name"]] = _OVERVIEW[key] or {}
    return out


def router_hosts_interactive(setup: dict) -> None:
    rc = setup.setdefault("router", {})
    hosts = rc.setdefault("hosts", [])
    while True:
        say("\n  Router machines:")
        if not hosts:
            say("    (none yet)")
        for h in hosts:
            ov = _OVERVIEW.pop((h["name"], h.get("ssh"), h["root"]), None) or host_overview(h)
            _OVERVIEW[(h["name"], h.get("ssh"), h["root"])] = ov
            tr = "unreachable" if ov is None else (", ".join(f"{k} {v}" for k, v in ov.items()) or "no translators")
            flags = [f for f, on in (("preferred", h["name"] in rc.get("prefer", [])),
                                     ("excluded", h["name"] in rc.get("exclude", []))) if on]
            sp = rc.get("speed", {}).get(h["name"])
            say(f"    {h['name']:10} {h.get('ssh') or '(this machine)'}:{h['root']}  {tr}"
                + (f"  [{', '.join(flags)}]" if flags else "") + (f"  speed {sp}" if sp else ""))
        a = ask("[a]dd, [r]emove, [p]refer, e[x]clude, [s]peed, [d]one", "a" if not hosts else "d").lower()[:1]
        if a == "a":
            ssh = ask("ssh user@host (empty: this machine)", "")
            name = ask("short name", (ssh.split("@")[-1].split(".")[0] if ssh else platform.node().split(".")[0]) or "local")
            guess = str(ROOT) if not ssh else "~/Software/llm-translators"
            if ssh:
                info = probe(ssh, guess)
                if info and not info.get("llmt") and info.get("shared"):
                    guess = info["shared"]
                    say(f"  {ssh} has a shared install: {guess}")
            root = ask("llm-translators folder there", guess)
            hosts[:] = [h for h in hosts if h["name"] != name] + [{"name": name, "ssh": ssh, "root": root}]
        elif a == "r":
            n = ask("machine to remove", "")
            hosts[:] = [h for h in hosts if h["name"] != n]
        elif a == "p":
            rc["prefer"] = [x for x in ask("preferred machines, in order (comma-separated)",
                                           ",".join(rc.get("prefer", []))).replace(" ", "").split(",") if x]
        elif a == "x":
            rc["exclude"] = [x for x in ask("excluded machines (comma-separated)",
                                            ",".join(rc.get("exclude", []))).replace(" ", "").split(",") if x]
        elif a == "s":
            cur = ",".join(f"{k}={v}" for k, v in rc.get("speed", {}).items())
            sp = {}
            for part in ask("speed factors, machine=factor (1 = normal, 0.8 = 20 % faster runs)", cur).split(","):
                k_, _, v_ = part.strip().partition("=")
                try:
                    sp[k_] = float(v_)
                except ValueError:
                    pass
            rc["speed"] = sp
        else:
            break
    save_setup(setup)


def has_claude_app() -> bool:
    """A Claude desktop app is (probably) used on this machine."""
    return sys.platform == "darwin" or os.name == "nt" or claude_desktop_config().exists()


