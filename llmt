def prefix_of(a) -> Path:
    if getattr(a, "prefix", None):
        return Path(os.path.abspath(os.path.expanduser(a.prefix)))
    return PREFIX if SHARED else DEFAULT_PREFIX


def rel_key(p: Path):
    m = REL_NAME.match(p.name)
    return tuple(int(x) for x in m.groups()) if m else (0,)


def releases_in(prefix: Path, complete: bool = True) -> list[Path]:
    d = prefix / "releases"
    if not d.is_dir():
        return []
    out = [p for p in d.iterdir() if p.is_dir() and REL_NAME.match(p.name)
           and (not complete or (p / "RELEASE.json").exists())]
    return sorted(out, key=rel_key)


def current_release(prefix: Path) -> Path | None:
    cur = prefix / "current"
    if cur.is_symlink() or cur.exists():
        try:
            return cur.resolve()
        except OSError:
            return None
    return None


def next_release_name(prefix: Path) -> str:
    today = _dt.date.today().strftime("%Y.%m.%d")
    n = [int(p.name.rsplit(".", 1)[1]) for p in releases_in(prefix, complete=False) if p.name.startswith(today + ".")]
    return f"{today}.{max(n, default=0) + 1}"


def switch_current(prefix: Path, rel: Path) -> None:
    """Points <prefix>/current to rel in one step (a new relative symlink renamed over the old one)."""
    tmp = prefix / ".current.new"
    if tmp.is_symlink() or tmp.exists():
        tmp.unlink()
    os.symlink(Path("releases") / rel.name, tmp)
    os.replace(tmp, prefix / "current")


def releases_in_use(prefix: Path) -> dict[str, list[str]]:
    """Releases that running processes (MCP servers, their workers, running jobs) or queued SLURM jobs use."""
    base = str((prefix / "releases").resolve()) + "/"
    pat = re.compile(re.escape(base) + r"([0-9.]+)/")
    used: dict[str, list[str]] = {}
    proc = Path("/proc")
    if proc.is_dir():
        for d in proc.iterdir():
            if not d.name.isdigit():
                continue
            try:  # the program and its script (python, then e.g. .venv/bin/cfdt-mcp): not text that mentions a path
                argv = (d / "cmdline").read_bytes().split(b"\0")[:2]
                cmd = " ".join(x.decode(errors="replace") for x in argv)
            except OSError:
                continue
            for name in set(pat.findall(cmd + " ")):
                who = ""
                try:
                    import pwd
                    who = pwd.getpwuid(d.stat().st_uid).pw_name
                except (ImportError, KeyError, OSError):
                    pass
                used.setdefault(name, []).append(f"process {d.name}" + (f" ({who})" if who else ""))
    if shutil.which("squeue"):
        try:
            r = subprocess.run(["squeue", "-h", "-o", "%i|%u|%o"], capture_output=True, text=True, timeout=20)
            for line in r.stdout.splitlines():
                jid, user, script = (line.split("|") + ["", "", ""])[:3]
                try:
                    text = Path(script).read_text(errors="replace")[:20000]
                except OSError:
                    continue
                for name in set(pat.findall(text)):
                    used.setdefault(name, []).append(f"job {jid} ({user})")
        except (OSError, subprocess.TimeoutExpired):
            pass
    return used


def export_tree(src: Path, dst: Path) -> None:
    """The committed files of the git checkout src (its HEAD) into dst."""
    dst.mkdir(parents=True, exist_ok=True)
    a = subprocess.Popen(["git", "-C", str(src), "archive", "--format=tar", "HEAD"], stdout=subprocess.PIPE)
    t = subprocess.run(["tar", "-x", "-C", str(dst)], stdin=a.stdout)
    a.stdout.close()
    if a.wait() != 0 or t.returncode != 0:
        die(f"could not export {src} (git archive HEAD)")


def make_readonly(root: Path) -> None:
    for d, dirs, files in os.walk(root):
        os.chmod(d, 0o755)
        for f in files:
            p = os.path.join(d, f)
            if os.path.islink(p):
                continue
            m = os.stat(p).st_mode & 0o777
            os.chmod(p, (m | 0o444 | (0o111 if m & 0o100 else 0)) & ~0o022)


def cmd_deploy(a) -> None:
    if SHARED:
        die("deploy builds from a checkout (e.g. /opt/llm-translators/src), not from inside a release")
    prefix = prefix_of(a)
    r = git("rev-parse", "HEAD", check=False)
    if r.returncode != 0:
        git_trouble(r.stderr, fatal=True)
    subs = submodule_states()
    keys = parse_keys(a.keys) if a.keys else [k for k in KEYS if subs.get(REGISTRY[k]["repo"], ("absent",))[0] != "absent"]
    if not keys:
        die("no translator is checked out here: sudo git submodule update --init (docs/SHARED.md)")
    problems = []
    for k in keys:
        repo = REGISTRY[k]["repo"]
        st = subs.get(repo, ("absent", ""))[0]
        if st == "absent":
            problems.append(f"{repo} is not checked out (git submodule update --init {repo})")
        elif st != "pinned":
            problems.append(f"{repo} is not at the umbrella's pin ({st}): git submodule update {repo}")
        elif git("-C", repo, "status", "--porcelain", check=False).stdout.strip():
            problems.append(f"{repo} has uncommitted changes (they would not be deployed)")
    if git("status", "--porcelain", "--ignore-submodules=all", check=False).stdout.strip():
        problems.append("the umbrella has uncommitted changes (they would not be deployed)")
    if problems:
        for p_ in problems:
            warn(p_)
        if not a.allow_dirty:
            die("fix these, or deploy the committed state anyway with --allow-dirty")
    try:
        (prefix / "releases").mkdir(parents=True, exist_ok=True)
        probe_f = prefix / "releases" / ".write-test"
        probe_f.write_text("")
        probe_f.unlink()
    except OSError:
        die(f"no write access to {prefix}: run as the admin (sudo ./llmt deploy) or choose --prefix")
    name = next_release_name(prefix)
    rel = prefix / "releases" / name
    say(f"Building release {name} in {rel} ({', '.join(keys)})")
    ok = False
    try:
        export_tree(ROOT, rel)
        for k in keys:
            export_tree(ROOT / REGISTRY[k]["repo"], rel / REGISTRY[k]["repo"])
        for f in ["llmt", "llmt_router.py", "bin/run", "bin/mcp", "bin/router"]:   # executable whatever git recorded
            if (rel / f).exists():
                os.chmod(rel / f, 0o755)
        # the venv
        needs_gmsh = any(b["key"] == "gmsh" for k in keys for b in REGISTRY[k]["backends"])
        arm_linux = sys.platform.startswith("linux") and platform.machine() in ("aarch64", "arm64")
        py = a.python or ("/usr/bin/python3" if arm_linux and needs_gmsh else default_python())
        v = python_version(py)
        if not v or v < (3, 10):
            die(f"{py}: Python 3.10+ needed (--python)")
        vdir = rel / ".venv"
        vpy = vdir / "bin" / "python"
        run([py, "-m", "venv", "--prompt", f"llm-translators {name}", vdir])
        run([vpy, "-m", "pip", "install", "--quiet", "--upgrade", "pip"])
        extra_opt: dict[str, list[str]] = {}
        for spec in a.extra or []:
            k_, _, e_ = spec.partition(":")
            if k_ not in REGISTRY or e_ not in REGISTRY[k_]["optional_extras"]:
                die(f"--extra {spec}: expected KEY:EXTRA")
            extra_opt.setdefault(k_, []).append(e_)
        specs = []
        for k in keys:
            t = REGISTRY[k]
            ex = list(t["extras"]) + ([t["test_extra"]] if t.get("test_extra") else []) + extra_opt.get(k, [])
            specs += ["-e", f"{rel / t['repo']}[{','.join(ex)}]"]
        run([vpy, "-m", "pip", "install", *specs])
        if needs_gmsh and run([vpy, "-c", "import gmsh"], capture=True, check=False).returncode != 0:
            sysmod = Path("/usr/lib/python3/dist-packages/gmsh.py")
            site = vdir / "lib" / f"python{v[0]}.{v[1]}" / "site-packages"
            if sysmod.exists() and site.is_dir():
                (site / "gmsh.py").symlink_to(sysmod)
                say(f"  linked {sysmod} into the venv")
            else:
                warn(f"Gmsh is not importable in the release's venv: see {BACKENDS_MD}#gmsh")
        run([vpy, "-m", "compileall", "-q", "-j", "0", str(rel)], check=False)
        commits = {REGISTRY[k]["repo"]: git("-C", REGISTRY[k]["repo"], "rev-parse", "HEAD").stdout.strip() for k in keys}
        import getpass
        info = {"release": name, "llmt": __version__, "created": _dt.datetime.now().isoformat(timespec="seconds"),
                "built_by": getpass.getuser(), "python": f"{py} ({'.'.join(map(str, v))})", "keys": keys,
                "umbrella": git("rev-parse", "HEAD").stdout.strip(), "commits": commits, "source": str(ROOT),
                "dirty": bool(problems)}
        (rel / "RELEASE.json").write_text(json.dumps(info, indent=1) + "\n")
        make_readonly(rel)
        # the machine's settings file: created once, then only new settings described
        global ENV_FILE
        saved, ENV_FILE = ENV_FILE, SYSTEM_ENV
        try:
            if not SYSTEM_ENV.exists():
                ensure_env_file()
                os.chmod(SYSTEM_ENV, 0o644)
                say(f"  created {SYSTEM_ENV} (the machine's settings: edit it with llmt env --system --edit)")
            else:
                added = env_refresh()
                if added:
                    say(f"  {SYSTEM_ENV}: described the new settings {', '.join(added)}")
        except OSError as exc:
            warn(f"could not write {SYSTEM_ENV} ({exc}): create it as the admin")
        finally:
            ENV_FILE = saved
        # checks, with the new release's own llmt
        say("\nChecking the new release")
        r = subprocess.run([sys.executable, str(rel / "llmt"), "status", "--json", *keys], capture_output=True, text=True)
        try:
            st = json.loads(r.stdout)
        except json.JSONDecodeError:
            die(f"the new release's status failed:\n{(r.stderr or r.stdout)[-1500:]}")
        bad = [k for k in keys if not st["translators"].get(k, {}).get("version")]
        for k in keys:
            d = st["translators"].get(k, {})
            miss = [n for n, v_ in d.get("backends", {}).items() if not v_["found"]]
            say(f"  {k:5} {d.get('version') or 'NOT IMPORTABLE'}" + (f"; missing: {', '.join(miss)}" if miss else ""))
        if bad:
            die(f"not importable in the new release: {', '.join(bad)}")
        if a.test:
            r = subprocess.run([sys.executable, str(rel / "llmt"), "test", *keys])
            if r.returncode != 0:
                die("tests failed: the release is kept but not switched to (llmt rollback / gc)")
        if a.bench:
            for k in keys:
                if REGISTRY[k]["bench"] and subprocess.run([sys.executable, str(rel / "llmt"), "bench", k]).returncode != 0:
                    die(f"{k} benchmarks failed: the release is kept but not switched to")
        ok = True
    finally:
        if not ok and rel.exists() and not (rel / "RELEASE.json").exists():
            shutil.rmtree(rel, ignore_errors=True)
            warn(f"removed the incomplete {rel}")
    if a.no_switch:
        say(f"\nRelease {name} is ready; users still get {current_release(prefix) or 'nothing'}. Switch: llmt rollback {name}")
        return
    old = current_release(prefix)
    switch_current(prefix, rel)
    say(f"\n{prefix / 'current'} -> releases/{name}" + (f" (was {old.name})" if old else ""))
    say("  New MCP sessions use it; running servers and queued jobs finish on the release they started with.")
    say(f"  Users: MCP entries run {prefix / 'current'}/bin/mcp KEY; llmt alias points llmt-venv there.")
    say("  Undo: llmt rollback. Old releases: llmt gc.")


def cmd_releases(a) -> None:
    prefix = prefix_of(a)
    rels = releases_in(prefix)
    if not rels:
        say(f"  no releases in {prefix}/releases")
        return
    cur = current_release(prefix)
    used = releases_in_use(prefix)
    say(f"  {prefix}")
    for r in reversed(rels):
        info = release_info(r)
        mark = "current" if cur == r.resolve() else ""
        use = used.get(r.name, [])
        say(f"  {r.name:14} {mark:8} {info.get('created', '?'):20} {','.join(info.get('keys', [])):28} "
            + (f"in use: {len(use)} ({', '.join(use[:3])}{'...' if len(use) > 3 else ''})" if use else ""))


def cmd_rollback(a) -> None:
    prefix = prefix_of(a)
    rels = releases_in(prefix)
    cur = current_release(prefix)
    if a.release:
        target = prefix / "releases" / a.release
        if target not in rels:
            die(f"no complete release {a.release} in {prefix}/releases (llmt releases)")
    else:
        older = [r for r in rels if cur is None or rel_key(r) < rel_key(cur)]
        if not older:
            die("no release older than the current one")
        target = older[-1]
    switch_current(prefix, target)
    say(f"{prefix / 'current'} -> releases/{target.name}" + (f" (was {cur.name})" if cur else ""))


def cmd_gc(a) -> None:
    prefix = prefix_of(a)
    rels = releases_in(prefix, complete=False)
    cur = current_release(prefix)
    used = releases_in_use(prefix)
    complete = [r for r in rels if (r / "RELEASE.json").exists()]
    keep = set(complete[-max(a.keep, 1):]) | ({cur} if cur else set())
    drop = [r for r in rels if r not in keep and r.resolve() != cur and r.name not in used]
    for r in rels:
        if r.name in used and r not in keep:
            say(f"  keeping {r.name}: in use ({', '.join(used[r.name][:3])})")
    if not drop:
        say("  nothing to remove")
        return
    say("  to remove: " + ", ".join(r.name for r in drop))
    if not a.yes and not (sys.stdin.isatty() and yes("Remove them?", False)):
        say("  nothing removed (--yes to remove without asking)")
        return
    for r in drop:
        shutil.rmtree(r)
        say(f"  removed {r.name}")


